{
"dur": 42.90091666666667,
"caps": [
{
"t": 0.2,
"e": 0.653,
"text": "Деньги",
"seg": "s01"
},
{
"t": 0.653,
"e": 1.617,
"text": "только тратятся",
"seg": "s01"
},
{
"t": 1.617,
"e": 2.184,
"text": "и ничего",
"seg": "s01"
},
{
"t": 2.184,
"e": 3.317,
"text": "не приносят?",
"seg": "s01"
},
{
"t": 3.317,
"e": 4.394,
"text": "У белки из сказки",
"seg": "s01"
},
{
"t": 4.394,
"e": 5.471,
"text": "было иначе.",
"seg": "s01"
},
{
"t": 5.691,
"e": 6.88,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.88,
"e": 7.474,
"text": "правило,",
"seg": "s02"
},
{
"t": 7.474,
"e": 8.664,
"text": "которое это чинит.",
"seg": "s02"
},
{
"t": 8.884,
"e": 9.567,
"text": "У Пушкина",
"seg": "s03"
},
{
"t": 9.567,
"e": 10.438,
"text": "белка грызёт",
"seg": "s03"
},
{
"t": 10.438,
"e": 10.935,
"text": "орешки:",
"seg": "s03"
},
{
"t": 10.935,
"e": 12.365,
"text": "скорлупки золотые,",
"seg": "s03"
},
{
"t": 12.365,
"e": 13.732,
"text": "ядра — изумруд.",
"seg": "s03"
},
{
"t": 13.732,
"e": 14.602,
"text": "Из скорлупок",
"seg": "s03"
},
{
"t": 14.602,
"e": 15.845,
"text": "льют монету.",
"seg": "s03"
},
{
"t": 16.065,
"e": 16.823,
"text": "Орешки работают",
"seg": "s04"
},
{
"t": 16.823,
"e": 17.58,
"text": "каждый день,",
"seg": "s04"
},
{
"t": 17.58,
"e": 17.981,
"text": "и казна",
"seg": "s04"
},
{
"t": 17.981,
"e": 18.872,
"text": "растёт сама.",
"seg": "s04"
},
{
"t": 19.092,
"e": 19.79,
"text": "А наши деньги",
"seg": "s05"
},
{
"t": 19.79,
"e": 20.349,
"text": "лежат дома",
"seg": "s05"
},
{
"t": 20.349,
"e": 20.814,
"text": "и только",
"seg": "s05"
},
{
"t": 20.814,
"e": 21.606,
"text": "дешевеют.",
"seg": "s05"
},
{
"t": 21.826,
"e": 22.256,
"text": "Тысяча",
"seg": "s06"
},
{
"t": 22.256,
"e": 23.01,
"text": "под подушкой",
"seg": "s06"
},
{
"t": 23.01,
"e": 23.978,
"text": "через 5 лет —",
"seg": "s06"
},
{
"t": 23.978,
"e": 25.109,
"text": "та же тысяча.",
"seg": "s06"
},
{
"t": 25.109,
"e": 25.701,
"text": "На вкладе",
"seg": "s06"
},
{
"t": 25.701,
"e": 27.208,
"text": "под 10% годовых,",
"seg": "s06"
},
{
"t": 27.208,
"e": 27.961,
"text": "с процентами",
"seg": "s06"
},
{
"t": 27.961,
"e": 28.715,
"text": "на проценты, —",
"seg": "s06"
},
{
"t": 28.715,
"e": 30.598,
"text": "около 1600.",
"seg": "s06"
},
{
"t": 30.818,
"e": 31.253,
"text": "Правило:",
"seg": "s07"
},
{
"t": 31.253,
"e": 32.171,
"text": "отложенные деньги",
"seg": "s07"
},
{
"t": 32.171,
"e": 33.041,
"text": "не держите дома —",
"seg": "s07"
},
{
"t": 33.041,
"e": 34.104,
"text": "пусть приносят доход",
"seg": "s07"
},
{
"t": 34.104,
"e": 35.313,
"text": "в надёжном банке.",
"seg": "s07"
},
{
"t": 35.533,
"e": 36.478,
"text": "Пусть каждый орешек",
"seg": "s08"
},
{
"t": 36.478,
"e": 37.244,
"text": "работает.",
"seg": "s08"
},
{
"t": 37.464,
"e": 37.912,
"text": "Дальше:",
"seg": "s09"
},
{
"t": 37.912,
"e": 38.472,
"text": "Буратино",
"seg": "s09"
},
{
"t": 38.472,
"e": 39.816,
"text": "и билет в театр.",
"seg": "s09"
},
{
"t": 39.816,
"e": 40.657,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 40.657,
"e": 41.217,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 41.217,
"e": 42.281,
"text": "пропустить.",
"seg": "s09"
}
],
