{
"dur": 45.46725,
"caps": [
{
"t": 0.2,
"e": 1.623,
"text": "Снять все накопления",
"seg": "s01"
},
{
"t": 1.623,
"e": 2.981,
"text": "ради покупки?",
"seg": "s01"
},
{
"t": 2.981,
"e": 3.822,
"text": "Хозяин гуся",
"seg": "s01"
},
{
"t": 3.822,
"e": 5.18,
"text": "так и сделал.",
"seg": "s01"
},
{
"t": 5.4,
"e": 6.23,
"text": "Тридцать секунд —",
"seg": "s02"
},
{
"t": 6.23,
"e": 6.829,
"text": "правило,",
"seg": "s02"
},
{
"t": 6.829,
"e": 7.429,
"text": "сохраняющее",
"seg": "s02"
},
{
"t": 7.429,
"e": 8.074,
"text": "доход.",
"seg": "s02"
},
{
"t": 8.294,
"e": 8.994,
"text": "Гусь нёс",
"seg": "s03"
},
{
"t": 8.994,
"e": 10.466,
"text": "золотые яйца.",
"seg": "s03"
},
{
"t": 10.466,
"e": 11.937,
"text": "Хозяину стало мало —",
"seg": "s03"
},
{
"t": 11.937,
"e": 13.478,
"text": "разрезал гуся.",
"seg": "s03"
},
{
"t": 13.698,
"e": 14.214,
"text": "Внутри",
"seg": "s04"
},
{
"t": 14.214,
"e": 15.182,
"text": "ничего.",
"seg": "s04"
},
{
"t": 15.182,
"e": 16.214,
"text": "Яйца кончились",
"seg": "s04"
},
{
"t": 16.214,
"e": 17.311,
"text": "навсегда.",
"seg": "s04"
},
{
"t": 17.531,
"e": 18.489,
"text": "Накопления —",
"seg": "s05"
},
{
"t": 18.489,
"e": 19.447,
"text": "гусь.",
"seg": "s05"
},
{
"t": 19.447,
"e": 20.257,
"text": "Проценты —",
"seg": "s05"
},
{
"t": 20.257,
"e": 21.215,
"text": "яйца.",
"seg": "s05"
},
{
"t": 21.215,
"e": 22.615,
"text": "Тысяча — пятьдесят",
"seg": "s05"
},
{
"t": 22.615,
"e": 23.647,
"text": "в год.",
"seg": "s05"
},
{
"t": 23.867,
"e": 24.464,
"text": "Снял всё —",
"seg": "s06"
},
{
"t": 24.464,
"e": 25.387,
"text": "пятьдесят в год",
"seg": "s06"
},
{
"t": 25.387,
"e": 25.876,
"text": "исчезли",
"seg": "s06"
},
{
"t": 25.876,
"e": 26.799,
"text": "насовсем.",
"seg": "s06"
},
{
"t": 27.019,
"e": 28.62,
"text": "Тратим яйца,",
"seg": "s07"
},
{
"t": 28.62,
"e": 30.314,
"text": "а не гуся.",
"seg": "s07"
},
{
"t": 30.314,
"e": 31.255,
"text": "Покупка —",
"seg": "s07"
},
{
"t": 31.255,
"e": 32.95,
"text": "из дохода.",
"seg": "s07"
},
{
"t": 33.17,
"e": 34.632,
"text": "Покупка дороже?",
"seg": "s08"
},
{
"t": 34.632,
"e": 35.84,
"text": "Копи отдельно,",
"seg": "s08"
},
{
"t": 35.84,
"e": 37.366,
"text": "запас не трогай.",
"seg": "s08"
},
{
"t": 37.586,
"e": 37.91,
"text": "Итог:",
"seg": "s09"
},
{
"t": 37.91,
"e": 38.397,
"text": "не режь",
"seg": "s09"
},
{
"t": 38.397,
"e": 39.101,
"text": "гуся.",
"seg": "s09"
},
{
"t": 39.321,
"e": 39.786,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 39.786,
"e": 40.717,
"text": "Емеля и деньги",
"seg": "s10"
},
{
"t": 40.717,
"e": 42.288,
"text": "по щучьему веленью.",
"seg": "s10"
},
{
"t": 42.288,
"e": 43.16,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 43.16,
"e": 43.742,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 43.742,
"e": 44.847,
"text": "пропустить.",
"seg": "s10"
}
],
