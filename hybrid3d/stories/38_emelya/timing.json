{
"dur": 40.756875,
"caps": [
{
"t": 0.2,
"e": 1.628,
"text": "Лотерейный билет",
"seg": "s01"
},
{
"t": 1.628,
"e": 3.295,
"text": "и ждёте чуда?",
"seg": "s01"
},
{
"t": 3.295,
"e": 4.247,
"text": "Емеля тоже",
"seg": "s01"
},
{
"t": 4.247,
"e": 5.438,
"text": "лежал на печи",
"seg": "s01"
},
{
"t": 5.658,
"e": 6.908,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.908,
"e": 7.485,
"text": "расчёт,",
"seg": "s02"
},
{
"t": 7.485,
"e": 8.591,
"text": "который удивит.",
"seg": "s02"
},
{
"t": 8.811,
"e": 9.796,
"text": "Емелю выручила",
"seg": "s03"
},
{
"t": 9.796,
"e": 11.212,
"text": "волшебная щука.",
"seg": "s03"
},
{
"t": 11.212,
"e": 11.766,
"text": "В жизни",
"seg": "s03"
},
{
"t": 11.766,
"e": 13.305,
"text": "щука не приходит.",
"seg": "s03"
},
{
"t": 13.525,
"e": 14.598,
"text": "Шанс джекпота —",
"seg": "s04"
},
{
"t": 14.598,
"e": 15.603,
"text": "меньше одного",
"seg": "s04"
},
{
"t": 15.603,
"e": 16.877,
"text": "на миллион.",
"seg": "s04"
},
{
"t": 17.097,
"e": 17.95,
"text": "Билет за 5",
"seg": "s05"
},
{
"t": 17.95,
"e": 18.804,
"text": "каждую неделю —",
"seg": "s05"
},
{
"t": 18.804,
"e": 20.404,
"text": "260 в год.",
"seg": "s05"
},
{
"t": 20.624,
"e": 21.45,
"text": "За 5 лет —",
"seg": "s06"
},
{
"t": 21.45,
"e": 23.047,
"text": "1300.",
"seg": "s06"
},
{
"t": 23.047,
"e": 23.377,
"text": "Ушли",
"seg": "s06"
},
{
"t": 23.377,
"e": 24.313,
"text": "в никуда.",
"seg": "s06"
},
{
"t": 24.533,
"e": 25.522,
"text": "Правило своей щуки:",
"seg": "s07"
},
{
"t": 25.522,
"e": 26.66,
"text": "те же 5 в неделю —",
"seg": "s07"
},
{
"t": 26.66,
"e": 27.402,
"text": "в копилку,",
"seg": "s07"
},
{
"t": 27.402,
"e": 28.54,
"text": "в день получки.",
"seg": "s07"
},
{
"t": 28.76,
"e": 29.491,
"text": "Через 5 лет —",
"seg": "s08"
},
{
"t": 29.491,
"e": 30.792,
"text": "1300 ваших,",
"seg": "s08"
},
{
"t": 30.792,
"e": 31.726,
"text": "гарантированно.",
"seg": "s08"
},
{
"t": 31.946,
"e": 32.236,
"text": "Итог:",
"seg": "s09"
},
{
"t": 32.236,
"e": 33.296,
"text": "чудо не приходит,",
"seg": "s09"
},
{
"t": 33.296,
"e": 34.405,
"text": "копилка растёт.",
"seg": "s09"
},
{
"t": 34.625,
"e": 35.15,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 35.15,
"e": 35.544,
"text": "Заяц",
"seg": "s10"
},
{
"t": 35.544,
"e": 37.25,
"text": "пустил лису в дом.",
"seg": "s10"
},
{
"t": 37.25,
"e": 38.234,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 38.234,
"e": 38.89,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 38.89,
"e": 40.137,
"text": "пропустить.",
"seg": "s10"
}
