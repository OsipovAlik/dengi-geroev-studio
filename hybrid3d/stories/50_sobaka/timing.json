{
"dur": 45.917541666666665,
"caps": [
{
"t": 0.2,
"e": 0.944,
"text": "Вам обещают",
"seg": "s01"
},
{
"t": 0.944,
"e": 1.861,
"text": "удвоить деньги",
"seg": "s01"
},
{
"t": 1.861,
"e": 2.834,
"text": "за месяц?",
"seg": "s01"
},
{
"t": 2.834,
"e": 3.693,
"text": "Не разжимайте",
"seg": "s01"
},
{
"t": 3.693,
"e": 4.438,
"text": "зубы.",
"seg": "s01"
},
{
"t": 4.658,
"e": 5.81,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 5.81,
"e": 6.386,
"text": "правило,",
"seg": "s02"
},
{
"t": 6.386,
"e": 7.095,
"text": "которое спасёт",
"seg": "s02"
},
{
"t": 7.095,
"e": 7.937,
"text": "сбережения.",
"seg": "s02"
},
{
"t": 8.157,
"e": 9.115,
"text": "Собака из басни",
"seg": "s03"
},
{
"t": 9.115,
"e": 9.847,
"text": "Эзопа несла",
"seg": "s03"
},
{
"t": 9.847,
"e": 10.917,
"text": "кусок мяса.",
"seg": "s03"
},
{
"t": 10.917,
"e": 11.367,
"text": "В воде",
"seg": "s03"
},
{
"t": 11.367,
"e": 12.494,
"text": "она увидела собаку",
"seg": "s03"
},
{
"t": 12.494,
"e": 13.057,
"text": "с куском",
"seg": "s03"
},
{
"t": 13.057,
"e": 14.239,
"text": "вдвое больше.",
"seg": "s03"
},
{
"t": 14.459,
"e": 15.469,
"text": "Разинула пасть —",
"seg": "s04"
},
{
"t": 15.469,
"e": 16.3,
"text": "и свой кусок",
"seg": "s04"
},
{
"t": 16.3,
"e": 17.191,
"text": "утонул.",
"seg": "s04"
},
{
"t": 17.191,
"e": 17.785,
"text": "Там было",
"seg": "s04"
},
{
"t": 17.785,
"e": 19.151,
"text": "лишь отражение.",
"seg": "s04"
},
{
"t": 19.371,
"e": 20.294,
"text": "«Удвоим за месяц» —",
"seg": "s05"
},
{
"t": 20.294,
"e": 21.524,
"text": "то же отражение.",
"seg": "s05"
},
{
"t": 21.524,
"e": 21.985,
"text": "Отдаёте",
"seg": "s05"
},
{
"t": 21.985,
"e": 23.573,
"text": "100 настоящих,",
"seg": "s05"
},
{
"t": 23.573,
"e": 24.137,
"text": "получаете",
"seg": "s05"
},
{
"t": 24.137,
"e": 25.828,
"text": "обещание 200.",
"seg": "s05"
},
{
"t": 26.048,
"e": 27.051,
"text": "Обещание исчезло —",
"seg": "s06"
},
{
"t": 27.051,
"e": 28.107,
"text": "у вас 0.",
"seg": "s06"
},
{
"t": 28.327,
"e": 28.829,
"text": "Правило:",
"seg": "s07"
},
{
"t": 28.829,
"e": 29.442,
"text": "настоящее",
"seg": "s07"
},
{
"t": 29.442,
"e": 30.0,
"text": "не меняй",
"seg": "s07"
},
{
"t": 30.0,
"e": 31.172,
"text": "на обещанное.",
"seg": "s07"
},
{
"t": 31.172,
"e": 31.786,
"text": "Рискуешь —",
"seg": "s07"
},
{
"t": 31.786,
"e": 34.408,
"text": "максимум 10 из 100.",
"seg": "s07"
},
{
"t": 34.408,
"e": 35.356,
"text": "В худшем случае",
"seg": "s07"
},
{
"t": 35.356,
"e": 36.974,
"text": "останется 90.",
"seg": "s07"
},
{
"t": 37.194,
"e": 37.53,
"text": "Итог:",
"seg": "s08"
},
{
"t": 37.53,
"e": 38.93,
"text": "держи свой кусок.",
"seg": "s08"
},
{
"t": 39.15,
"e": 39.597,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 39.597,
"e": 40.547,
"text": "братец Иванушка",
"seg": "s09"
},
{
"t": 40.547,
"e": 41.385,
"text": "и покупки,",
"seg": "s09"
},
{
"t": 41.385,
"e": 42.838,
"text": "о которых жалеешь.",
"seg": "s09"
},
{
"t": 42.838,
"e": 43.677,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 43.677,
"e": 44.236,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 44.236,
"e": 45.298,
"text": "пропустить.",
"seg": "s09"
}
