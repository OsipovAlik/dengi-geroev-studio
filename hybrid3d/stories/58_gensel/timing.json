},
{
"t": 0.729,
"e": 1.365,
"text": "бесплатный",
"seg": "s01"
},
{
"t": 1.365,
"e": 2.423,
"text": "пробный период,",
"seg": "s01"
},
{
"t": 2.423,
"e": 3.006,
"text": "а с карты",
"seg": "s01"
},
{
"t": 3.006,
"e": 4.223,
"text": "списали деньги?",
"seg": "s01"
},
{
"t": 4.223,
"e": 5.229,
"text": "Гензель и Гретель",
"seg": "s01"
},
{
"t": 5.229,
"e": 6.394,
"text": "тоже попались.",
"seg": "s01"
},
{
"t": 6.614,
"e": 7.683,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 7.683,
"e": 8.012,
"text": "как не",
"seg": "s02"
},
{
"t": 8.012,
"e": 8.752,
"text": "попасться.",
"seg": "s02"
},
{
"t": 8.972,
"e": 9.424,
"text": "Дети ели",
"seg": "s03"
},
{
"t": 9.424,
"e": 10.192,
"text": "пряничный домик",
"seg": "s03"
},
{
"t": 10.192,
"e": 10.689,
"text": "даром,",
"seg": "s03"
},
{
"t": 10.689,
"e": 11.412,
"text": "а потом ведьма",
"seg": "s03"
},
{
"t": 11.412,
"e": 12.18,
"text": "заперла Гензеля",
"seg": "s03"
},
{
"t": 12.18,
"e": 12.949,
"text": "в клетке.",
"seg": "s03"
},
{
"t": 13.169,
"e": 13.878,
"text": "Пробный период",
"seg": "s04"
},
{
"t": 13.878,
"e": 14.233,
"text": "так же:",
"seg": "s04"
},
{
"t": 14.233,
"e": 14.765,
"text": "7 дней",
"seg": "s04"
},
{
"t": 14.765,
"e": 15.429,
"text": "бесплатно,",
"seg": "s04"
},
{
"t": 15.429,
"e": 15.873,
"text": "а дальше",
"seg": "s04"
},
{
"t": 15.873,
"e": 16.316,
"text": "подписка",
"seg": "s04"
},
{
"t": 16.316,
"e": 17.469,
"text": "продлевается сама.",
"seg": "s04"
},
{
"t": 17.689,
"e": 19.187,
"text": "10 в месяц.",
"seg": "s05"
},
{
"t": 19.187,
"e": 20.186,
"text": "Забыли отменить —",
"seg": "s05"
},
{
"t": 20.186,
"e": 20.63,
"text": "за год",
"seg": "s05"
},
{
"t": 20.63,
"e": 21.962,
"text": "120.",
"seg": "s05"
},
{
"t": 22.182,
"e": 23.21,
"text": "А таких подписок",
"seg": "s06"
},
{
"t": 23.21,
"e": 23.553,
"text": "три —",
"seg": "s06"
},
{
"t": 23.553,
"e": 24.752,
"text": "уже 360",
"seg": "s06"
},
{
"t": 24.752,
"e": 25.552,
"text": "в год.",
"seg": "s06"
},
{
"t": 25.552,
"e": 26.18,
"text": "За то,",
"seg": "s06"
},
{
"t": 26.18,
"e": 26.637,
"text": "чем вы",
"seg": "s06"
},
{
"t": 26.637,
"e": 27.951,
"text": "не пользуетесь.",
"seg": "s06"
},
{
"t": 28.171,
"e": 28.659,
"text": "Правило:",
"seg": "s07"
},
{
"t": 28.659,
"e": 29.69,
"text": "оформили пробный —",
"seg": "s07"
},
{
"t": 29.69,
"e": 30.503,
"text": "в тот же день",
"seg": "s07"
},
{
"t": 30.503,
"e": 31.1,
"text": "отключите",
"seg": "s07"
},
{
"t": 31.1,
"e": 32.293,
"text": "автопродление.",
"seg": "s07"
},
{
"t": 32.513,
"e": 33.394,
"text": "Нужен сервис —",
"seg": "s08"
},
{
"t": 33.394,
"e": 34.685,
"text": "включите сами.",
"seg": "s08"
},
{
"t": 34.685,
"e": 35.566,
"text": "А раз в месяц",
"seg": "s08"
},
{
"t": 35.566,
"e": 36.798,
"text": "проверяйте подписки",
"seg": "s08"
},
{
"t": 36.798,
"e": 37.855,
"text": "в выписке.",
"seg": "s08"
},
{
"t": 38.075,
"e": 38.53,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 38.53,
"e": 39.611,
"text": "солдат из «Огнива» —",
"seg": "s09"
},
{
"t": 39.611,
"e": 41.033,
"text": "куда пропали друзья,",
"seg": "s09"
},
{
"t": 41.033,
"e": 42.001,
"text": "когда кончились",
"seg": "s09"
},
{
"t": 42.001,
"e": 42.854,
"text": "деньги.",
"seg": "s09"
},
{
"t": 42.854,
"e": 43.707,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 43.707,
"e": 44.276,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 44.276,
"e": 45.357,
