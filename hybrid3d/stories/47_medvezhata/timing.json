{
"dur": 44.26495833333333,
"caps": [
{
"t": 0.2,
"e": 1.875,
"text": "Отправили 100,",
"seg": "s01"
},
{
"t": 1.875,
"e": 3.334,
"text": "а дошло 86?",
"seg": "s01"
},
{
"t": 3.334,
"e": 4.739,
"text": "Это лиса-посредник.",
"seg": "s01"
},
{
"t": 4.959,
"e": 6.138,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.138,
"e": 7.181,
"text": "как её поймать.",
"seg": "s02"
},
{
"t": 7.401,
"e": 8.3,
"text": "Два медвежонка",
"seg": "s03"
},
{
"t": 8.3,
"e": 8.917,
"text": "нашли сыр",
"seg": "s03"
},
{
"t": 8.917,
"e": 10.546,
"text": "и не смогли поделить.",
"seg": "s03"
},
{
"t": 10.546,
"e": 10.883,
"text": "Лиса",
"seg": "s03"
},
{
"t": 10.883,
"e": 12.287,
"text": "вызвалась помочь.",
"seg": "s03"
},
{
"t": 12.507,
"e": 13.846,
"text": "Откусит от большего —",
"seg": "s04"
},
{
"t": 13.846,
"e": 15.491,
"text": "больше стал другой.",
"seg": "s04"
},
{
"t": 15.491,
"e": 16.221,
"text": "И так, пока",
"seg": "s04"
},
{
"t": 16.221,
"e": 17.866,
"text": "не остались крошки.",
"seg": "s04"
},
{
"t": 18.086,
"e": 19.837,
"text": "С переводами так же.",
"seg": "s05"
},
{
"t": 19.837,
"e": 20.963,
"text": "Обмен — 5,",
"seg": "s05"
},
{
"t": 20.963,
"e": 22.214,
"text": "перевод — 5,",
"seg": "s05"
},
{
"t": 22.214,
"e": 23.591,
"text": "снятие — 4.",
"seg": "s05"
},
{
"t": 23.811,
"e": 24.667,
"text": "Каждый кусочек",
"seg": "s06"
},
{
"t": 24.667,
"e": 25.47,
"text": "маленький,",
"seg": "s06"
},
{
"t": 25.47,
"e": 26.058,
"text": "а вместе —",
"seg": "s06"
},
{
"t": 26.058,
"e": 28.091,
"text": "14 из 100.",
"seg": "s06"
},
{
"t": 28.091,
"e": 29.269,
"text": "Почти седьмая часть —",
"seg": "s06"
},
{
"t": 29.269,
"e": 29.964,
"text": "лисе.",
"seg": "s06"
},
{
"t": 30.184,
"e": 30.677,
"text": "Правило:",
"seg": "s07"
},
{
"t": 30.677,
"e": 31.608,
"text": "спрашивайте,",
"seg": "s07"
},
{
"t": 31.608,
"e": 32.484,
"text": "сколько дойдёт",
"seg": "s07"
},
{
"t": 32.484,
"e": 33.689,
"text": "до получателя.",
"seg": "s07"
},
{
"t": 33.689,
"e": 34.236,
"text": "Сравните",
"seg": "s07"
},
{
"t": 34.236,
"e": 35.714,
"text": "2–3 способа.",
"seg": "s07"
},
{
"t": 35.934,
"e": 36.261,
"text": "Итог:",
"seg": "s08"
},
{
"t": 36.261,
"e": 37.022,
"text": "делите сами —",
"seg": "s08"
},
{
"t": 37.022,
"e": 38.381,
"text": "и не зовите лису.",
"seg": "s08"
},
{
"t": 38.601,
"e": 38.959,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 38.959,
"e": 39.717,
"text": "петушок и лиса —",
"seg": "s09"
},
{
"t": 39.717,
"e": 40.521,
"text": "почему мошенники",
"seg": "s09"
},
{
"t": 40.521,
"e": 41.681,
"text": "звонят второй раз.",
"seg": "s09"
},
{
"t": 41.681,
"e": 42.351,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 42.351,
"e": 42.797,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 42.797,
"e": 43.645,
"text": "пропустить.",
"seg": "s09"
}
],
