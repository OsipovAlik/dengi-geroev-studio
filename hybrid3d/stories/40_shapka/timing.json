{
"dur": 42.88458333333333,
"caps": [
{
"t": 0.2,
"e": 1.155,
"text": "Мама пишет",
"seg": "s01"
},
{
"t": 1.155,
"e": 3.064,
"text": "с нового номера?",
"seg": "s01"
},
{
"t": 3.064,
"e": 4.177,
"text": "Шапочка тоже",
"seg": "s01"
},
{
"t": 4.177,
"e": 6.087,
"text": "не узнала волка.",
"seg": "s01"
},
{
"t": 6.307,
"e": 7.473,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 7.473,
"e": 8.056,
"text": "правило,",
"seg": "s02"
},
{
"t": 8.056,
"e": 8.818,
"text": "которое защитит",
"seg": "s02"
},
{
"t": 8.818,
"e": 9.715,
"text": "ваши деньги.",
"seg": "s02"
},
{
"t": 9.936,
"e": 10.579,
"text": "Волк надел",
"seg": "s03"
},
{
"t": 10.579,
"e": 11.436,
"text": "бабушкин чепец",
"seg": "s03"
},
{
"t": 11.436,
"e": 12.722,
"text": "и лёг в кровать.",
"seg": "s03"
},
{
"t": 12.942,
"e": 13.48,
"text": "Мошенники",
"seg": "s04"
},
{
"t": 13.48,
"e": 14.214,
"text": "делают так же:",
"seg": "s04"
},
{
"t": 14.214,
"e": 15.143,
"text": "чужой аккаунт,",
"seg": "s04"
},
{
"t": 15.143,
"e": 15.974,
"text": "родное фото,",
"seg": "s04"
},
{
"t": 15.974,
"e": 17.001,
"text": "срочная беда.",
"seg": "s04"
},
{
"t": 17.221,
"e": 18.16,
"text": "Три признака волка:",
"seg": "s05"
},
{
"t": 18.16,
"e": 18.957,
"text": "новый номер,",
"seg": "s05"
},
{
"t": 18.957,
"e": 19.52,
"text": "срочно,",
"seg": "s05"
},
{
"t": 19.52,
"e": 20.693,
"text": "никому не говори.",
"seg": "s05"
},
{
"t": 20.913,
"e": 21.603,
"text": "Перевели —",
"seg": "s06"
},
{
"t": 21.603,
"e": 22.544,
"text": "и деньги ушли",
"seg": "s06"
},
{
"t": 22.544,
"e": 23.673,
"text": "за минуту.",
"seg": "s06"
},
{
"t": 23.673,
"e": 24.614,
"text": "Вернуть почти",
"seg": "s06"
},
{
"t": 24.614,
"e": 25.806,
"text": "невозможно.",
"seg": "s06"
},
{
"t": 26.026,
"e": 26.58,
"text": "Правило:",
"seg": "s07"
},
{
"t": 26.58,
"e": 27.503,
"text": "положи трубку",
"seg": "s07"
},
{
"t": 27.503,
"e": 28.303,
"text": "и перезвони",
"seg": "s07"
},
{
"t": 28.303,
"e": 29.78,
"text": "на старый номер.",
"seg": "s07"
},
{
"t": 30.0,
"e": 30.852,
"text": "Или спроси то,",
"seg": "s08"
},
{
"t": 30.852,
"e": 31.659,
"text": "что знает только",
"seg": "s08"
},
{
"t": 31.659,
"e": 32.6,
"text": "свой человек.",
"seg": "s08"
},
{
"t": 32.82,
"e": 33.154,
"text": "Итог:",
"seg": "s09"
},
{
"t": 33.154,
"e": 34.042,
"text": "просят срочно —",
"seg": "s09"
},
{
"t": 34.042,
"e": 35.32,
"text": "проверь дважды.",
"seg": "s09"
},
{
"t": 35.54,
"e": 36.062,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 36.062,
"e": 37.107,
"text": "каша из топора",
"seg": "s10"
},
{
"t": 37.107,
"e": 37.956,
"text": "как дешёвое",
"seg": "s10"
},
{
"t": 37.956,
"e": 39.392,
"text": "стало дорогим.",
"seg": "s10"
},
{
"t": 39.392,
"e": 40.371,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 40.371,
"e": 41.024,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 41.024,
"e": 42.265,
"text": "пропустить.",
"seg": "s10"
}
],
