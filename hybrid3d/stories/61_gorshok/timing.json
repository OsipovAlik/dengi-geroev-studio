{
"dur": 44.34404166666667,
"caps": [
{
"t": 0.2,
"e": 1.192,
"text": "Карта платит,",
"seg": "s01"
},
{
"t": 1.192,
"e": 1.854,
"text": "даже когда",
"seg": "s01"
},
{
"t": 1.854,
"e": 3.122,
"text": "денег уже ноль?",
"seg": "s01"
},
{
"t": 3.122,
"e": 3.893,
"text": "Это горшочек",
"seg": "s01"
},
{
"t": 3.893,
"e": 4.886,
"text": "из сказки.",
"seg": "s01"
},
{
"t": 5.106,
"e": 6.266,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.266,
"e": 6.756,
"text": "слово,",
"seg": "s02"
},
{
"t": 6.756,
"e": 8.273,
"text": "которое его останавливает.",
"seg": "s02"
},
{
"t": 8.493,
"e": 9.783,
"text": "У братьев Гримм",
"seg": "s03"
},
{
"t": 9.783,
"e": 10.846,
"text": "мама сказала:",
"seg": "s03"
},
{
"t": 10.846,
"e": 12.061,
"text": "«Горшочек, вари!» —",
"seg": "s03"
},
{
"t": 12.061,
"e": 13.275,
"text": "а слов «не вари»",
"seg": "s03"
},
{
"t": 13.275,
"e": 14.565,
"text": "не знала.",
"seg": "s03"
},
{
"t": 14.565,
"e": 15.552,
"text": "Каша залила",
"seg": "s03"
},
{
"t": 15.552,
"e": 17.07,
"text": "дом и улицу.",
"seg": "s03"
},
{
"t": 17.29,
"e": 17.87,
"text": "Овердрафт",
"seg": "s04"
},
{
"t": 17.87,
"e": 18.872,
"text": "и кредитный лимит",
"seg": "s04"
},
{
"t": 18.872,
"e": 19.769,
"text": "работают так же:",
"seg": "s04"
},
{
"t": 19.769,
"e": 20.929,
"text": "деньги кончились,",
"seg": "s04"
},
{
"t": 20.929,
"e": 22.301,
"text": "а оплата проходит.",
"seg": "s04"
},
{
"t": 22.301,
"e": 22.933,
"text": "Только это",
"seg": "s04"
},
{
"t": 22.933,
"e": 23.83,
"text": "уже долг.",
"seg": "s04"
},
{
"t": 24.05,
"e": 24.687,
"text": "Ушли в минус",
"seg": "s05"
},
{
"t": 24.687,
"e": 25.597,
"text": "на 100",
"seg": "s05"
},
{
"t": 25.597,
"e": 26.734,
"text": "под 30% годовых —",
"seg": "s05"
},
{
"t": 26.734,
"e": 27.235,
"text": "через год",
"seg": "s05"
},
{
"t": 27.235,
"e": 28.964,
"text": "отдаёте около 130.",
"seg": "s05"
},
{
"t": 29.184,
"e": 29.748,
"text": "Правило:",
"seg": "s06"
},
{
"t": 29.748,
"e": 30.564,
"text": "знайте своё",
"seg": "s06"
},
{
"t": 30.564,
"e": 31.568,
"text": "«не вари».",
"seg": "s06"
},
{
"t": 31.568,
"e": 32.885,
"text": "Отключите овердрафт",
"seg": "s06"
},
{
"t": 32.885,
"e": 33.826,
"text": "или поставьте",
"seg": "s06"
},
{
"t": 33.826,
"e": 34.579,
"text": "лимит трат",
"seg": "s06"
},
{
"t": 34.579,
"e": 35.645,
"text": "на карту.",
"seg": "s06"
},
{
"t": 35.865,
"e": 36.23,
"text": "Тратьте",
"seg": "s07"
},
{
"t": 36.23,
"e": 37.042,
"text": "только своё.",
"seg": "s07"
},
{
"t": 37.262,
"e": 37.7,
"text": "Завтра:",
"seg": "s08"
},
{
"t": 37.7,
"e": 38.576,
"text": "Лягушка и вол —",
"seg": "s08"
},
{
"t": 38.576,
"e": 39.507,
"text": "как лопнуть,",
"seg": "s08"
},
{
"t": 39.507,
"e": 40.383,
"text": "покупая статус",
"seg": "s08"
},
{
"t": 40.383,
"e": 41.314,
"text": "в кредит.",
"seg": "s08"
},
{
"t": 41.314,
"e": 42.136,
"text": "Подпишись,",
"seg": "s08"
},
{
"t": 42.136,
"e": 42.684,
"text": "чтобы не",
"seg": "s08"
},
{
"t": 42.684,
"e": 43.724,
"text": "пропустить.",
"seg": "s08"
}
],
