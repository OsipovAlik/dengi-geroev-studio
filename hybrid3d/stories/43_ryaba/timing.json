{
"dur": 42.611583333333336,
"caps": [
{
"t": 0.2,
"e": 0.848,
"text": "Все деньги",
"seg": "s01"
},
{
"t": 0.848,
"e": 2.089,
"text": "на одной карте?",
"seg": "s01"
},
{
"t": 2.089,
"e": 3.385,
"text": "Курочка Ряба знает,",
"seg": "s01"
},
{
"t": 3.385,
"e": 4.788,
"text": "чем это кончается.",
"seg": "s01"
},
{
"t": 5.008,
"e": 6.418,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.418,
"e": 6.905,
"text": "правило",
"seg": "s02"
},
{
"t": 6.905,
"e": 7.881,
"text": "трёх мест.",
"seg": "s02"
},
{
"t": 8.101,
"e": 8.811,
"text": "Дед бил —",
"seg": "s03"
},
{
"t": 8.811,
"e": 10.089,
"text": "не разбил.",
"seg": "s03"
},
{
"t": 10.089,
"e": 10.941,
"text": "Баба била —",
"seg": "s03"
},
{
"t": 10.941,
"e": 12.29,
"text": "не разбила.",
"seg": "s03"
},
{
"t": 12.51,
"e": 12.951,
"text": "А мышка",
"seg": "s04"
},
{
"t": 12.951,
"e": 13.933,
"text": "махнула хвостиком —",
"seg": "s04"
},
{
"t": 13.933,
"e": 15.16,
"text": "и яйцо разбилось.",
"seg": "s04"
},
{
"t": 15.38,
"e": 16.124,
"text": "Мышка — это",
"seg": "s05"
},
{
"t": 16.124,
"e": 17.487,
"text": "блокировка карты,",
"seg": "s05"
},
{
"t": 17.487,
"e": 18.479,
"text": "кража телефона",
"seg": "s05"
},
{
"t": 18.479,
"e": 20.152,
"text": "или лопнувший банк.",
"seg": "s05"
},
{
"t": 20.372,
"e": 21.276,
"text": "Всё в одном месте —",
"seg": "s06"
},
{
"t": 21.276,
"e": 22.09,
"text": "одна случайность",
"seg": "s06"
},
{
"t": 22.09,
"e": 23.582,
"text": "забирает 100%.",
"seg": "s06"
},
{
"t": 23.802,
"e": 24.501,
"text": "Три места —",
"seg": "s07"
},
{
"t": 24.501,
"e": 25.375,
"text": "и она заберёт",
"seg": "s07"
},
{
"t": 25.375,
"e": 26.598,
"text": "только треть.",
"seg": "s07"
},
{
"t": 26.818,
"e": 27.311,
"text": "Правило:",
"seg": "s08"
},
{
"t": 27.311,
"e": 28.514,
"text": "подушка отдельно,",
"seg": "s08"
},
{
"t": 28.514,
"e": 29.827,
"text": "накопления в банке,",
"seg": "s08"
},
{
"t": 29.827,
"e": 30.811,
"text": "немного наличных",
"seg": "s08"
},
{
"t": 30.811,
"e": 31.523,
"text": "дома.",
"seg": "s08"
},
{
"t": 31.743,
"e": 32.08,
"text": "Итог:",
"seg": "s09"
},
{
"t": 32.08,
"e": 32.698,
"text": "одно яйцо",
"seg": "s09"
},
{
"t": 32.698,
"e": 33.991,
"text": "мышка разобьёт.",
"seg": "s09"
},
{
"t": 33.991,
"e": 34.666,
"text": "Три сразу —",
"seg": "s09"
},
{
"t": 34.666,
"e": 35.565,
"text": "вряд ли.",
"seg": "s09"
},
{
"t": 35.785,
"e": 36.297,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 36.297,
"e": 37.513,
"text": "лебедь, рак и щука",
"seg": "s10"
},
{
"t": 37.513,
"e": 39.176,
"text": "и семейный бюджет.",
"seg": "s10"
},
{
"t": 39.176,
"e": 40.136,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 40.136,
"e": 40.776,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 40.776,
"e": 41.992,
"text": "пропустить.",
"seg": "s10"
}
