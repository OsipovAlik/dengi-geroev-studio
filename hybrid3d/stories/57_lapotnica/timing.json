{
"dur": 41.816833333333335,
"caps": [
{
"t": 0.2,
"e": 0.817,
"text": "Заплатили",
"seg": "s01"
},
{
"t": 0.817,
"e": 2.108,
"text": "за доставку приза,",
"seg": "s01"
},
{
"t": 2.108,
"e": 3.286,
"text": "а просят ещё?",
"seg": "s01"
},
{
"t": 3.286,
"e": 3.567,
"text": "Это",
"seg": "s01"
},
{
"t": 3.567,
"e": 4.801,
"text": "лиса-лапотница.",
"seg": "s01"
},
{
"t": 5.021,
"e": 6.093,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.093,
"e": 6.464,
"text": "как это",
"seg": "s02"
},
{
"t": 6.464,
"e": 7.248,
"text": "остановить.",
"seg": "s02"
},
{
"t": 7.468,
"e": 8.383,
"text": "Лиса подложила",
"seg": "s03"
},
{
"t": 8.383,
"e": 9.298,
"text": "лапоть к курам:",
"seg": "s03"
},
{
"t": 9.298,
"e": 10.041,
"text": "«куры съели —",
"seg": "s03"
},
{
"t": 10.041,
"e": 11.014,
"text": "отдайте курочку!»",
"seg": "s03"
},
{
"t": 11.234,
"e": 12.742,
"text": "Курочку — к гусям:",
"seg": "s04"
},
{
"t": 12.742,
"e": 13.915,
"text": "«отдайте гуся!»",
"seg": "s04"
},
{
"t": 13.915,
"e": 15.34,
"text": "Гуся — к баранам:",
"seg": "s04"
},
{
"t": 15.34,
"e": 16.68,
"text": "«отдайте барана!»",
"seg": "s04"
},
{
"t": 16.9,
"e": 17.739,
"text": "Мошенники так же:",
"seg": "s05"
},
{
"t": 17.739,
"e": 18.532,
"text": "доставка приза —",
"seg": "s05"
},
{
"t": 18.532,
"e": 19.277,
"text": "10,",
"seg": "s05"
},
{
"t": 19.277,
"e": 19.65,
"text": "налог —",
"seg": "s05"
},
{
"t": 19.65,
"e": 20.396,
"text": "20,",
"seg": "s05"
},
{
"t": 20.396,
"e": 20.862,
"text": "пошлина —",
"seg": "s05"
},
{
"t": 20.862,
"e": 21.747,
"text": "40.",
"seg": "s05"
},
{
"t": 21.967,
"e": 22.638,
"text": "Каждый раз",
"seg": "s06"
},
{
"t": 22.638,
"e": 23.029,
"text": "вдвое:",
"seg": "s06"
},
{
"t": 23.029,
"e": 24.146,
"text": "уже 80,",
"seg": "s06"
},
{
"t": 24.146,
"e": 25.822,
"text": "всего 150.",
"seg": "s06"
},
{
"t": 25.822,
"e": 26.939,
"text": "А приза нет.",
"seg": "s06"
},
{
"t": 27.159,
"e": 27.922,
"text": "Жалко бросить —",
"seg": "s07"
},
{
"t": 27.922,
"e": 28.638,
"text": "на этом схема",
"seg": "s07"
},
{
"t": 28.638,
"e": 29.545,
"text": "и держится.",
"seg": "s07"
},
{
"t": 29.765,
"e": 30.259,
"text": "Правило:",
"seg": "s08"
},
{
"t": 30.259,
"e": 30.918,
"text": "за выигрыш",
"seg": "s08"
},
{
"t": 30.918,
"e": 31.907,
"text": "не платят.",
"seg": "s08"
},
{
"t": 31.907,
"e": 32.785,
"text": "Первая просьба",
"seg": "s08"
},
{
"t": 32.785,
"e": 33.444,
"text": "доплатить —",
"seg": "s08"
},
{
"t": 33.444,
"e": 34.433,
"text": "уже обман.",
"seg": "s08"
},
{
"t": 34.653,
"e": 35.072,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 35.072,
"e": 36.119,
"text": "Гензель и Гретель —",
"seg": "s09"
},
{
"t": 36.119,
"e": 37.323,
"text": "бесплатный пряник,",
"seg": "s09"
},
{
"t": 37.323,
"e": 37.794,
"text": "который",
"seg": "s09"
},
{
"t": 37.794,
"e": 38.893,
"text": "стоит дорого.",
"seg": "s09"
},
{
"t": 38.893,
"e": 39.679,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 39.679,
"e": 40.202,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 40.202,
"e": 41.197,
"text": "пропустить.",
"seg": "s09"
}
],
