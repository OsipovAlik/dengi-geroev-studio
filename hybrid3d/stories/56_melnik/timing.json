{
"dur": 41.93958333333333,
"caps": [
{
"t": 0.2,
"e": 0.782,
"text": "Экономите",
"seg": "s01"
},
{
"t": 0.782,
"e": 2.0,
"text": "на каждой булочке,",
"seg": "s01"
},
{
"t": 2.0,
"e": 2.477,
"text": "а денег",
"seg": "s01"
},
{
"t": 2.477,
"e": 3.641,
"text": "всё равно нет?",
"seg": "s01"
},
{
"t": 3.641,
"e": 4.647,
"text": "Мельник у Крылова",
"seg": "s01"
},
{
"t": 4.647,
"e": 5.336,
"text": "тоже.",
"seg": "s01"
},
{
"t": 5.556,
"e": 6.646,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.646,
"e": 7.442,
"text": "где на самом деле",
"seg": "s02"
},
{
"t": 7.442,
"e": 8.49,
"text": "течёт ваш бюджет.",
"seg": "s02"
},
{
"t": 8.71,
"e": 9.327,
"text": "У мельника",
"seg": "s03"
},
{
"t": 9.327,
"e": 10.097,
"text": "вода сочилась",
"seg": "s03"
},
{
"t": 10.097,
"e": 11.279,
"text": "сквозь плотину.",
"seg": "s03"
},
{
"t": 11.279,
"e": 12.564,
"text": "Чинить было лень.",
"seg": "s03"
},
{
"t": 12.784,
"e": 13.795,
"text": "Течь росла,",
"seg": "s04"
},
{
"t": 13.795,
"e": 15.311,
"text": "мельница встала.",
"seg": "s04"
},
{
"t": 15.311,
"e": 15.69,
"text": "А он",
"seg": "s04"
},
{
"t": 15.69,
"e": 16.575,
"text": "ругал курицу:",
"seg": "s04"
},
{
"t": 16.575,
"e": 17.523,
"text": "«пьёт мою воду!»",
"seg": "s04"
},
{
"t": 17.743,
"e": 18.354,
"text": "С деньгами",
"seg": "s05"
},
{
"t": 18.354,
"e": 19.117,
"text": "так же.",
"seg": "s05"
},
{
"t": 19.117,
"e": 19.727,
"text": "Отказались",
"seg": "s05"
},
{
"t": 19.727,
"e": 20.388,
"text": "от булочки —",
"seg": "s05"
},
{
"t": 20.388,
"e": 21.864,
"text": "сэкономили 2 в день,",
"seg": "s05"
},
{
"t": 21.864,
"e": 23.237,
"text": "60 в месяц.",
"seg": "s05"
},
{
"t": 23.457,
"e": 24.379,
"text": "А долг по карте —",
"seg": "s06"
},
{
"t": 24.379,
"e": 25.096,
"text": "3 тысячи",
"seg": "s06"
},
{
"t": 25.096,
"e": 26.326,
"text": "под 30% годовых:",
"seg": "s06"
},
{
"t": 26.326,
"e": 27.35,
"text": "75 в месяц",
"seg": "s06"
},
{
"t": 27.35,
"e": 28.272,
"text": "процентов.",
"seg": "s06"
},
{
"t": 28.492,
"e": 29.221,
"text": "Течь больше,",
"seg": "s07"
},
{
"t": 29.221,
"e": 30.294,
"text": "чем вся экономия.",
"seg": "s07"
},
{
"t": 30.514,
"e": 30.922,
"text": "Правило:",
"seg": "s08"
},
{
"t": 30.922,
"e": 31.512,
"text": "раз в месяц",
"seg": "s08"
},
{
"t": 31.512,
"e": 32.374,
"text": "найдите в выписке",
"seg": "s08"
},
{
"t": 32.374,
"e": 32.873,
"text": "три самые",
"seg": "s08"
},
{
"t": 32.873,
"e": 33.554,
"text": "большие траты",
"seg": "s08"
},
{
"t": 33.554,
"e": 34.053,
"text": "и латайте",
"seg": "s08"
},
{
"t": 34.053,
"e": 34.915,
"text": "сначала их.",
"seg": "s08"
},
{
"t": 35.135,
"e": 35.565,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 35.565,
"e": 36.425,
"text": "лиса-лапотница —",
"seg": "s09"
},
{
"t": 36.425,
"e": 37.286,
"text": "как заставляют",
"seg": "s09"
},
{
"t": 37.286,
"e": 38.093,
"text": "платить снова",
"seg": "s09"
},
{
"t": 38.093,
"e": 38.953,
"text": "и снова.",
"seg": "s09"
},
{
"t": 38.953,
"e": 39.76,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 39.76,
"e": 40.298,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 40.298,
"e": 41.32,
"text": "пропустить.",
"seg": "s09"
}
],
