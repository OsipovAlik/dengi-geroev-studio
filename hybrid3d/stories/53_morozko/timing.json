{
"dur": 42.927,
"caps": [
{
"t": 0.2,
"e": 0.704,
"text": "Боитесь",
"seg": "s01"
},
{
"t": 0.704,
"e": 2.105,
"text": "просить прибавку?",
"seg": "s01"
},
{
"t": 2.105,
"e": 3.393,
"text": "Молчание может стоить",
"seg": "s01"
},
{
"t": 3.393,
"e": 4.345,
"text": "больше зарплаты",
"seg": "s01"
},
{
"t": 4.345,
"e": 5.129,
"text": "в год.",
"seg": "s01"
},
{
"t": 5.349,
"e": 6.459,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.459,
"e": 7.185,
"text": "как просить,",
"seg": "s02"
},
{
"t": 7.185,
"e": 7.996,
"text": "чтобы дали.",
"seg": "s02"
},
{
"t": 8.216,
"e": 9.292,
"text": "Морозко спрашивал",
"seg": "s03"
},
{
"t": 9.292,
"e": 10.084,
"text": "двух девушек:",
"seg": "s03"
},
{
"t": 10.084,
"e": 11.33,
"text": "тепло ли тебе?",
"seg": "s03"
},
{
"t": 11.33,
"e": 11.953,
"text": "Падчерица",
"seg": "s03"
},
{
"t": 11.953,
"e": 13.029,
"text": "отвечала вежливо —",
"seg": "s03"
},
{
"t": 13.029,
"e": 13.708,
"text": "и получила",
"seg": "s03"
},
{
"t": 13.708,
"e": 14.897,
"text": "сундук добра.",
"seg": "s03"
},
{
"t": 15.117,
"e": 15.883,
"text": "Мачехина дочь",
"seg": "s04"
},
{
"t": 15.883,
"e": 16.343,
"text": "грубила",
"seg": "s04"
},
{
"t": 16.343,
"e": 17.058,
"text": "и требовала —",
"seg": "s04"
},
{
"t": 17.058,
"e": 17.824,
"text": "и не получила",
"seg": "s04"
},
{
"t": 17.824,
"e": 18.59,
"text": "ничего.",
"seg": "s04"
},
{
"t": 18.81,
"e": 19.546,
"text": "С прибавкой",
"seg": "s05"
},
{
"t": 19.546,
"e": 20.395,
"text": "так же.",
"seg": "s05"
},
{
"t": 20.395,
"e": 21.188,
"text": "«Мне мало,",
"seg": "s05"
},
{
"t": 21.188,
"e": 22.151,
"text": "платите больше» —",
"seg": "s05"
},
{
"t": 22.151,
"e": 23.567,
"text": "это грубый ответ.",
"seg": "s05"
},
{
"t": 23.787,
"e": 24.231,
"text": "Вежливо",
"seg": "s06"
},
{
"t": 24.231,
"e": 24.873,
"text": "и с цифрами:",
"seg": "s06"
},
{
"t": 24.873,
"e": 25.761,
"text": "что я сделал,",
"seg": "s06"
},
{
"t": 25.761,
"e": 26.994,
"text": "сколько за такую работу",
"seg": "s06"
},
{
"t": 26.994,
"e": 27.734,
"text": "платят другие",
"seg": "s06"
},
{
"t": 27.734,
"e": 28.918,
"text": "и сколько прошу.",
"seg": "s06"
},
{
"t": 29.138,
"e": 30.362,
"text": "Прибавка 10% —",
"seg": "s07"
},
{
"t": 30.362,
"e": 31.03,
"text": "за год это",
"seg": "s07"
},
{
"t": 31.03,
"e": 31.92,
"text": "целая зарплата",
"seg": "s07"
},
{
"t": 31.92,
"e": 33.366,
"text": "и ещё пятая часть.",
"seg": "s07"
},
{
"t": 33.586,
"e": 33.884,
"text": "Итог:",
"seg": "s08"
},
{
"t": 33.884,
"e": 34.829,
"text": "проси вежливо,",
"seg": "s08"
},
{
"t": 34.829,
"e": 35.824,
"text": "но с цифрой.",
"seg": "s08"
},
{
"t": 36.044,
"e": 36.469,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 36.469,
"e": 37.371,
"text": "Тришкин кафтан —",
"seg": "s09"
},
{
"t": 37.371,
"e": 38.486,
"text": "почему новый кредит",
"seg": "s09"
},
{
"t": 38.486,
"e": 39.972,
"text": "не закрывает старый.",
"seg": "s09"
},
{
"t": 39.972,
"e": 40.768,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 40.768,
"e": 41.299,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 41.299,
"e": 42.307,
"text": "пропустить.",
"seg": "s09"
}
],
