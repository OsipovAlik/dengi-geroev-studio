{
"dur": 42.90075,
"caps": [
{
"t": 0.2,
"e": 0.657,
"text": "Берёте",
"seg": "s01"
},
{
"t": 0.657,
"e": 1.514,
"text": "из сбережений",
"seg": "s01"
},
{
"t": 1.514,
"e": 2.657,
"text": "до зарплаты?",
"seg": "s01"
},
{
"t": 2.657,
"e": 3.115,
"text": "Свинья",
"seg": "s01"
},
{
"t": 3.115,
"e": 4.143,
"text": "из басни Крылова",
"seg": "s01"
},
{
"t": 4.143,
"e": 5.401,
"text": "делала так же.",
"seg": "s01"
},
{
"t": 5.621,
"e": 6.783,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.783,
"e": 7.364,
"text": "правило,",
"seg": "s02"
},
{
"t": 7.364,
"e": 8.168,
"text": "которое сохранит",
"seg": "s02"
},
{
"t": 8.168,
"e": 8.973,
"text": "ваш запас.",
"seg": "s02"
},
{
"t": 9.193,
"e": 10.232,
"text": "Свинья наелась",
"seg": "s03"
},
{
"t": 10.232,
"e": 10.817,
"text": "желудей",
"seg": "s03"
},
{
"t": 10.817,
"e": 12.051,
"text": "и стала подрывать",
"seg": "s03"
},
{
"t": 12.051,
"e": 13.285,
"text": "корни дуба.",
"seg": "s03"
},
{
"t": 13.285,
"e": 13.739,
"text": "Ворон:",
"seg": "s03"
},
{
"t": 13.739,
"e": 15.103,
"text": "дуб засохнет!",
"seg": "s03"
},
{
"t": 15.103,
"e": 15.558,
"text": "А она:",
"seg": "s03"
},
{
"t": 15.558,
"e": 16.142,
"text": "лишь бы",
"seg": "s03"
},
{
"t": 16.142,
"e": 17.441,
"text": "жёлуди были.",
"seg": "s03"
},
{
"t": 17.661,
"e": 18.133,
"text": "Но жёлуди",
"seg": "s04"
},
{
"t": 18.133,
"e": 18.477,
"text": "растут",
"seg": "s04"
},
{
"t": 18.477,
"e": 19.378,
"text": "на этом дубе.",
"seg": "s04"
},
{
"t": 19.598,
"e": 20.287,
"text": "Ваш дуб —",
"seg": "s05"
},
{
"t": 20.287,
"e": 21.873,
"text": "это сбережения.",
"seg": "s05"
},
{
"t": 21.873,
"e": 22.494,
"text": "Жёлуди —",
"seg": "s05"
},
{
"t": 22.494,
"e": 23.942,
"text": "доход от них.",
"seg": "s05"
},
{
"t": 24.162,
"e": 24.522,
"text": "Тысяча",
"seg": "s06"
},
{
"t": 24.522,
"e": 25.242,
"text": "под 10%",
"seg": "s06"
},
{
"t": 25.242,
"e": 26.548,
"text": "даёт 100 в год —",
"seg": "s06"
},
{
"t": 26.548,
"e": 27.223,
"text": "всегда.",
"seg": "s06"
},
{
"t": 27.223,
"e": 27.673,
"text": "Снимаете",
"seg": "s06"
},
{
"t": 27.673,
"e": 28.619,
"text": "по 300 —",
"seg": "s06"
},
{
"t": 28.619,
"e": 29.429,
"text": "через 4 года",
"seg": "s06"
},
{
"t": 29.429,
"e": 30.825,
"text": "меньше 100.",
"seg": "s06"
},
{
"t": 31.045,
"e": 31.581,
"text": "Правило:",
"seg": "s07"
},
{
"t": 31.581,
"e": 32.772,
"text": "тратьте жёлуди,",
"seg": "s07"
},
{
"t": 32.772,
"e": 33.903,
"text": "а не корни.",
"seg": "s07"
},
{
"t": 33.903,
"e": 34.618,
"text": "Сам запас —",
"seg": "s07"
},
{
"t": 34.618,
"e": 35.928,
"text": "только в беде.",
"seg": "s07"
},
{
"t": 36.148,
"e": 36.405,
"text": "Корни",
"seg": "s08"
},
{
"t": 36.405,
"e": 37.069,
"text": "не трогай.",
"seg": "s08"
},
{
"t": 37.289,
"e": 37.758,
"text": "Дальше:",
"seg": "s09"
},
{
"t": 37.758,
"e": 38.17,
"text": "петух",
"seg": "s09"
},
{
"t": 38.17,
"e": 39.697,
"text": "и жемчужное зерно.",
"seg": "s09"
},
{
"t": 39.697,
"e": 40.578,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 40.578,
"e": 41.165,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 41.165,
"e": 42.281,
"text": "пропустить.",
"seg": "s09"
}
