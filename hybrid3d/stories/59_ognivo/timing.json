{
"dur": 41.041333333333334,
"caps": [
{
"t": 0.2,
"e": 1.454,
"text": "Платите за всех,",
"seg": "s01"
},
{
"t": 1.454,
"e": 1.932,
"text": "а сами",
"seg": "s01"
},
{
"t": 1.932,
"e": 2.709,
"text": "до зарплаты",
"seg": "s01"
},
{
"t": 2.709,
"e": 3.725,
"text": "в минусе?",
"seg": "s01"
},
{
"t": 3.725,
"e": 4.8,
"text": "Солдат из «Огнива»",
"seg": "s01"
},
{
"t": 4.8,
"e": 5.995,
"text": "тоже платил.",
"seg": "s01"
},
{
"t": 6.215,
"e": 7.404,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 7.404,
"e": 7.998,
"text": "правило,",
"seg": "s02"
},
{
"t": 7.998,
"e": 9.188,
"text": "которое это чинит.",
"seg": "s02"
},
{
"t": 9.408,
"e": 10.265,
"text": "Пока у солдата",
"seg": "s03"
},
{
"t": 10.265,
"e": 11.175,
"text": "были деньги,",
"seg": "s03"
},
{
"t": 11.175,
"e": 12.354,
"text": "были и друзья.",
"seg": "s03"
},
{
"t": 12.354,
"e": 13.372,
"text": "Деньги кончились —",
"seg": "s03"
},
{
"t": 13.372,
"e": 13.854,
"text": "и никто",
"seg": "s03"
},
{
"t": 13.854,
"e": 14.55,
"text": "не поднялся",
"seg": "s03"
},
{
"t": 14.55,
"e": 15.89,
"text": "к нему на чердак.",
"seg": "s03"
},
{
"t": 16.11,
"e": 16.916,
"text": "С деньгами так же:",
"seg": "s04"
},
{
"t": 16.916,
"e": 17.893,
"text": "угощать на 30",
"seg": "s04"
},
{
"t": 17.893,
"e": 19.082,
"text": "из каждых 100 —",
"seg": "s04"
},
{
"t": 19.082,
"e": 19.974,
"text": "это 360",
"seg": "s04"
},
{
"t": 19.974,
"e": 20.611,
"text": "за год.",
"seg": "s04"
},
{
"t": 20.831,
"e": 21.235,
"text": "А запас",
"seg": "s05"
},
{
"t": 21.235,
"e": 21.999,
"text": "на чёрный день —",
"seg": "s05"
},
{
"t": 21.999,
"e": 22.584,
"text": "ноль.",
"seg": "s05"
},
{
"t": 22.804,
"e": 23.184,
"text": "Правило:",
"seg": "s06"
},
{
"t": 23.184,
"e": 23.733,
"text": "на угощение",
"seg": "s06"
},
{
"t": 23.733,
"e": 24.408,
"text": "и развлечения —",
"seg": "s06"
},
{
"t": 24.408,
"e": 24.873,
"text": "не больше",
"seg": "s06"
},
{
"t": 24.873,
"e": 26.478,
"text": "10 из 100.",
"seg": "s06"
},
{
"t": 26.698,
"e": 27.844,
"text": "Это 120",
"seg": "s07"
},
{
"t": 27.844,
"e": 28.663,
"text": "за год.",
"seg": "s07"
},
{
"t": 28.663,
"e": 29.701,
"text": "А 240",
"seg": "s07"
},
{
"t": 29.701,
"e": 30.52,
"text": "остаются вам —",
"seg": "s07"
},
{
"t": 30.52,
"e": 31.394,
"text": "в запас.",
"seg": "s07"
},
{
"t": 31.614,
"e": 32.538,
"text": "Настоящие друзья",
"seg": "s08"
},
{
"t": 32.538,
"e": 33.103,
"text": "останутся",
"seg": "s08"
},
{
"t": 33.103,
"e": 33.822,
"text": "и так.",
"seg": "s08"
},
{
"t": 34.042,
"e": 34.506,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 34.506,
"e": 35.434,
"text": "Демьянова уха —",
"seg": "s09"
},
{
"t": 35.434,
"e": 36.594,
"text": "как вам навязывают",
"seg": "s09"
},
{
"t": 36.594,
"e": 37.869,
"text": "ещё тарелочку.",
"seg": "s09"
},
{
"t": 37.869,
"e": 38.739,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 38.739,
"e": 39.319,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 39.319,
"e": 40.421,
"text": "пропустить.",
"seg": "s09"
}
