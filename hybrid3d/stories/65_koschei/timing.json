{
"dur": 42.302125,
"caps": [
{
"t": 0.2,
"e": 1.151,
"text": "Все ваши деньги",
"seg": "s01"
},
{
"t": 1.151,
"e": 2.381,
"text": "в одном месте?",
"seg": "s01"
},
{
"t": 2.381,
"e": 2.997,
"text": "Так погиб",
"seg": "s01"
},
{
"t": 2.997,
"e": 4.451,
"text": "Кощей Бессмертный.",
"seg": "s01"
},
{
"t": 4.671,
"e": 5.86,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 5.86,
"e": 6.455,
"text": "правило,",
"seg": "s02"
},
{
"t": 6.455,
"e": 7.644,
"text": "которое это чинит.",
"seg": "s02"
},
{
"t": 7.864,
"e": 8.76,
"text": "Смерть Кощея —",
"seg": "s03"
},
{
"t": 8.76,
"e": 9.476,
"text": "в игле,",
"seg": "s03"
},
{
"t": 9.476,
"e": 10.491,
"text": "игла в яйце,",
"seg": "s03"
},
{
"t": 10.491,
"e": 11.506,
"text": "яйцо в утке,",
"seg": "s03"
},
{
"t": 11.506,
"e": 12.581,
"text": "утка в зайце,",
"seg": "s03"
},
{
"t": 12.581,
"e": 13.954,
"text": "заяц в сундуке.",
"seg": "s03"
},
{
"t": 13.954,
"e": 14.252,
"text": "Всё",
"seg": "s03"
},
{
"t": 14.252,
"e": 15.566,
"text": "в одном месте.",
"seg": "s03"
},
{
"t": 15.786,
"e": 16.438,
"text": "Иван нашёл",
"seg": "s04"
},
{
"t": 16.438,
"e": 17.09,
"text": "сундук,",
"seg": "s04"
},
{
"t": 17.09,
"e": 17.851,
"text": "сломал иглу —",
"seg": "s04"
},
{
"t": 17.851,
"e": 18.721,
"text": "и конец.",
"seg": "s04"
},
{
"t": 18.941,
"e": 19.866,
"text": "С деньгами так же:",
"seg": "s05"
},
{
"t": 19.866,
"e": 20.84,
"text": "всё на одной карте",
"seg": "s05"
},
{
"t": 20.84,
"e": 22.107,
"text": "или в одном банке.",
"seg": "s05"
},
{
"t": 22.327,
"e": 22.623,
"text": "Сто",
"seg": "s06"
},
{
"t": 22.623,
"e": 23.513,
"text": "в одном месте:",
"seg": "s06"
},
{
"t": 23.513,
"e": 24.463,
"text": "заблокировали —",
"seg": "s06"
},
{
"t": 24.463,
"e": 25.65,
"text": "у вас 0.",
"seg": "s06"
},
{
"t": 25.65,
"e": 26.481,
"text": "Четыре места",
"seg": "s06"
},
{
"t": 26.481,
"e": 27.371,
"text": "по 25:",
"seg": "s06"
},
{
"t": 27.371,
"e": 28.261,
"text": "пропало одно —",
"seg": "s06"
},
{
"t": 28.261,
"e": 29.923,
"text": "осталось 75.",
"seg": "s06"
},
{
"t": 30.143,
"e": 30.65,
"text": "Правило:",
"seg": "s07"
},
{
"t": 30.65,
"e": 31.044,
"text": "запас",
"seg": "s07"
},
{
"t": 31.044,
"e": 31.889,
"text": "в трёх местах:",
"seg": "s07"
},
{
"t": 31.889,
"e": 32.904,
"text": "два разных банка",
"seg": "s07"
},
{
"t": 32.904,
"e": 33.524,
"text": "и немного",
"seg": "s07"
},
{
"t": 33.524,
"e": 34.538,
"text": "под рукой.",
"seg": "s07"
},
{
"t": 34.758,
"e": 35.492,
"text": "Не прячьте всё",
"seg": "s08"
},
{
"t": 35.492,
"e": 36.41,
"text": "в одно яйцо.",
"seg": "s08"
},
{
"t": 36.63,
"e": 37.111,
"text": "Дальше:",
"seg": "s09"
},
{
"t": 37.111,
"e": 37.532,
"text": "белка",
"seg": "s09"
},
{
"t": 37.532,
"e": 39.036,
"text": "и золотые орешки.",
"seg": "s09"
},
{
"t": 39.036,
"e": 39.938,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 39.938,
"e": 40.539,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 40.539,
"e": 41.682,
"text": "пропустить.",
