{
"dur": 43.36875,
"caps": [
{
"t": 0.2,
"e": 1.138,
"text": "Лёгкие деньги",
"seg": "s01"
},
{
"t": 1.138,
"e": 2.264,
"text": "за пустяк?",
"seg": "s01"
},
{
"t": 2.264,
"e": 2.764,
"text": "Плохиш",
"seg": "s01"
},
{
"t": 2.764,
"e": 4.265,
"text": "тоже согласился.",
"seg": "s01"
},
{
"t": 4.485,
"e": 5.292,
"text": "Тридцать секунд —",
"seg": "s02"
},
{
"t": 5.292,
"e": 6.054,
"text": "три вопроса,",
"seg": "s02"
},
{
"t": 6.054,
"e": 6.816,
"text": "которые спасают",
"seg": "s02"
},
{
"t": 6.816,
"e": 7.534,
"text": "кошелёк.",
"seg": "s02"
},
{
"t": 7.754,
"e": 8.085,
"text": "Плохиш",
"seg": "s03"
},
{
"t": 8.085,
"e": 8.54,
"text": "у Гайдара",
"seg": "s03"
},
{
"t": 8.54,
"e": 9.243,
"text": "продался врагам",
"seg": "s03"
},
{
"t": 9.243,
"e": 9.656,
"text": "за бочку",
"seg": "s03"
},
{
"t": 9.656,
"e": 10.318,
"text": "варенья.",
"seg": "s03"
},
{
"t": 10.538,
"e": 11.098,
"text": "Сегодня так:",
"seg": "s04"
},
{
"t": 11.098,
"e": 11.743,
"text": "оформи кредит",
"seg": "s04"
},
{
"t": 11.743,
"e": 12.26,
"text": "для друга —",
"seg": "s04"
},
{
"t": 12.26,
"e": 13.81,
"text": "получи 1000.",
"seg": "s04"
},
{
"t": 13.81,
"e": 14.456,
"text": "А долг потом —",
"seg": "s04"
},
{
"t": 14.456,
"e": 16.178,
"text": "100 000.",
"seg": "s04"
},
{
"t": 16.398,
"e": 18.367,
"text": "1 против 100.",
"seg": "s05"
},
{
"t": 18.367,
"e": 19.219,
"text": "Варенья хватит",
"seg": "s05"
},
{
"t": 19.219,
"e": 20.017,
"text": "на неделю,",
"seg": "s05"
},
{
"t": 20.017,
"e": 20.496,
"text": "а долг —",
"seg": "s05"
},
{
"t": 20.496,
"e": 21.348,
"text": "на годы.",
"seg": "s05"
},
{
"t": 21.568,
"e": 22.537,
"text": "Вопрос первый:",
"seg": "s06"
},
{
"t": 22.537,
"e": 23.312,
"text": "кто платит",
"seg": "s06"
},
{
"t": 23.312,
"e": 24.411,
"text": "и за что?",
"seg": "s06"
},
{
"t": 24.411,
"e": 25.638,
"text": "Платят за пустяк —",
"seg": "s06"
},
{
"t": 25.638,
"e": 27.06,
"text": "цена спрятана.",
"seg": "s06"
},
{
"t": 27.28,
"e": 27.757,
"text": "Второй:",
"seg": "s07"
},
{
"t": 27.757,
"e": 28.532,
"text": "что спросят",
"seg": "s07"
},
{
"t": 28.532,
"e": 29.367,
"text": "потом?",
"seg": "s07"
},
{
"t": 29.367,
"e": 29.844,
"text": "Третий:",
"seg": "s07"
},
{
"t": 29.844,
"e": 30.917,
"text": "кто отвечает,",
"seg": "s07"
},
{
"t": 30.917,
"e": 32.229,
"text": "если сорвётся?",
"seg": "s07"
},
{
"t": 32.449,
"e": 32.925,
"text": "Не можешь",
"seg": "s08"
},
{
"t": 32.925,
"e": 33.401,
"text": "ответить —",
"seg": "s08"
},
{
"t": 33.401,
"e": 34.137,
"text": "откажись.",
"seg": "s08"
},
{
"t": 34.357,
"e": 34.844,
"text": "Чем слаще",
"seg": "s09"
},
{
"t": 34.844,
"e": 35.597,
"text": "предложение,",
"seg": "s09"
},
{
"t": 35.597,
"e": 36.394,
"text": "тем внимательнее",
"seg": "s09"
},
{
"t": 36.394,
"e": 37.014,
"text": "читай.",
"seg": "s09"
},
{
"t": 37.234,
"e": 37.651,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 37.651,
"e": 38.587,
"text": "Мальчиш-Кибальчиш",
"seg": "s10"
},
{
"t": 38.587,
"e": 39.315,
"text": "и накопления",
"seg": "s10"
},
{
"t": 39.315,
"e": 40.46,
"text": "на общее дело.",
"seg": "s10"
},
{
"t": 40.46,
"e": 41.24,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 41.24,
"e": 41.76,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 41.76,
"e": 42.749,
"text": "пропустить.",
"seg": "s10"
}
