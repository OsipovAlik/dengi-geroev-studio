"seg": "s10"
},
{
"t": 40.283,
"e": 41.632,
"text": "рыбу хвостом.",
"seg": "s10"
},
{
"t": 41.632,
"e": 42.595,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 42.595,
"e": 43.237,
"text": "чтобы не",
"seg": "s10"
},
{
