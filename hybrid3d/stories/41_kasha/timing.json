"caps": [
{
"t": 0.2,
"e": 2.043,
"text": "Цена «от 100»,",
"seg": "s01"
},
{
"t": 2.043,
"e": 4.203,
"text": "а платите 140?",
"seg": "s01"
},
{
"t": 4.203,
"e": 5.346,
"text": "Солдат так варил",
"seg": "s01"
},
{
"t": 5.346,
"e": 6.808,
"text": "кашу из топора.",
"seg": "s01"
},
{
"t": 7.028,
"e": 8.141,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 8.141,
"e": 8.912,
"text": "как не попасться",
"seg": "s02"
},
{
"t": 8.912,
"e": 9.811,
"text": "на этот трюк.",
"seg": "s02"
},
{
"t": 10.031,
"e": 11.371,
"text": "Каша из топора,",
"seg": "s03"
},
{
"t": 11.371,
"e": 12.711,
"text": "а старуха добавила",
"seg": "s03"
},
{
"t": 12.711,
"e": 14.185,
"text": "крупу и масло.",
"seg": "s03"
},
{
"t": 14.405,
"e": 14.892,
"text": "Магазины",
"seg": "s04"
},
{
"t": 14.892,
"e": 15.624,
"text": "делают так же:",
"seg": "s04"
},
{
"t": 15.624,
"e": 16.599,
"text": "дешёвая основа,",
"seg": "s04"
},
{
"t": 16.599,
"e": 17.769,
"text": "дорогие добавки.",
"seg": "s04"
},
{
"t": 17.989,
"e": 19.919,
"text": "Телефон за 100.",
"seg": "s05"
},
{
"t": 19.919,
"e": 21.021,
"text": "А чехол, стекло,",
"seg": "s05"
},
{
"t": 21.021,
"e": 22.179,
"text": "страховка, доставка —",
"seg": "s05"
},
{
"t": 22.179,
"e": 23.446,
"text": "ещё 40.",
"seg": "s05"
},
{
"t": 23.666,
"e": 24.959,
"text": "Итого 140 —",
"seg": "s06"
},
{
"t": 24.959,
"e": 26.144,
"text": "на 40% больше",
"seg": "s06"
},
{
"t": 26.144,
"e": 27.006,
"text": "цены «от».",
"seg": "s06"
},
{
"t": 27.226,
"e": 27.693,
"text": "Правило:",
"seg": "s07"
},
{
"t": 27.693,
"e": 28.368,
"text": "считай итог",
"seg": "s07"
},
{
"t": 28.368,
"e": 29.198,
"text": "до покупки,",
"seg": "s07"
},
{
"t": 29.198,
"e": 30.6,
"text": "со всеми добавками.",
"seg": "s07"
},
{
"t": 30.82,
"e": 31.415,
"text": "Сравнивай",
"seg": "s08"
},
{
"t": 31.415,
"e": 32.497,
"text": "по полной цене,",
"seg": "s08"
},
{
"t": 32.497,
"e": 33.796,
"text": "а не по ценнику.",
"seg": "s08"
},
{
"t": 34.016,
"e": 34.484,
"text": "Итог:",
"seg": "s09"
},
{
"t": 34.484,
"e": 35.265,
"text": "цена «от» —",
"seg": "s09"
},
{
"t": 35.265,
"e": 37.217,
"text": "это только топор.",
"seg": "s09"
},
{
"t": 37.217,
"e": 38.779,
"text": "Каша дороже.",
"seg": "s09"
},
{
"t": 38.999,
"e": 39.513,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 39.513,
