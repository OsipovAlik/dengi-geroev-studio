{
"dur": 45.539208333333335,
"caps": [
{
"t": 0.2,
"e": 1.413,
"text": "Сделали работу,",
"seg": "s01"
},
{
"t": 1.413,
"e": 2.201,
"text": "а заплатить",
"seg": "s01"
},
{
"t": 2.201,
"e": 3.11,
"text": "«забыли»?",
"seg": "s01"
},
{
"t": 3.11,
"e": 3.959,
"text": "Так обманули",
"seg": "s01"
},
{
"t": 3.959,
"e": 5.475,
"text": "журавля из басни.",
"seg": "s01"
},
{
"t": 5.695,
"e": 6.854,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.854,
"e": 7.434,
"text": "правило,",
"seg": "s02"
},
{
"t": 7.434,
"e": 8.236,
"text": "которое защищает",
"seg": "s02"
},
{
"t": 8.236,
"e": 8.994,
"text": "ваш труд.",
"seg": "s02"
},
{
"t": 9.214,
"e": 10.308,
"text": "Волк подавился",
"seg": "s03"
},
{
"t": 10.308,
"e": 11.334,
"text": "костью.",
"seg": "s03"
},
{
"t": 11.334,
"e": 12.703,
"text": "Журавль вытащил её",
"seg": "s03"
},
{
"t": 12.703,
"e": 13.25,
"text": "клювом",
"seg": "s03"
},
{
"t": 13.25,
"e": 14.96,
"text": "и попросил плату.",
"seg": "s03"
},
{
"t": 14.96,
"e": 15.508,
"text": "А волк:",
"seg": "s03"
},
{
"t": 15.508,
"e": 16.807,
"text": "«Скажи спасибо,",
"seg": "s03"
},
{
"t": 16.807,
"e": 17.97,
"text": "что голову унёс!»",
"seg": "s03"
},
{
"t": 18.19,
"e": 18.812,
"text": "Ремонт,",
"seg": "s04"
},
{
"t": 18.812,
"e": 19.642,
"text": "подработка,",
"seg": "s04"
},
{
"t": 19.642,
"e": 20.108,
"text": "фриланс:",
"seg": "s04"
},
{
"t": 20.108,
"e": 20.938,
"text": "«Заплачу потом» —",
"seg": "s04"
},
{
"t": 20.938,
"e": 21.508,
"text": "и человек",
"seg": "s04"
},
{
"t": 21.508,
"e": 22.286,
"text": "пропал.",
"seg": "s04"
},
{
"t": 22.506,
"e": 24.456,
"text": "Заказ на 100.",
"seg": "s05"
},
{
"t": 24.456,
"e": 25.165,
"text": "Без аванса",
"seg": "s05"
},
{
"t": 25.165,
"e": 26.17,
"text": "заказчик исчез —",
"seg": "s05"
},
{
"t": 26.17,
"e": 27.352,
"text": "у вас 0.",
"seg": "s05"
},
{
"t": 27.352,
"e": 28.002,
"text": "С авансом",
"seg": "s05"
},
{
"t": 28.002,
"e": 28.77,
"text": "в половину —",
"seg": "s05"
},
{
"t": 28.77,
"e": 30.129,
"text": "уже 50.",
"seg": "s05"
},
{
"t": 30.349,
"e": 30.792,
"text": "Правило:",
"seg": "s06"
},
{
"t": 30.792,
"e": 31.924,
"text": "договор письменно,",
"seg": "s06"
},
{
"t": 31.924,
"e": 32.958,
"text": "аванс до начала,",
"seg": "s06"
},
{
"t": 32.958,
"e": 33.597,
"text": "сдали этап —",
"seg": "s06"
},
{
"t": 33.597,
"e": 34.631,
"text": "получили оплату,",
"seg": "s06"
},
{
"t": 34.631,
"e": 35.812,
"text": "потом следующий.",
"seg": "s06"
},
{
"t": 36.032,
"e": 36.47,
"text": "«Спасибо»",
"seg": "s07"
},
{
"t": 36.47,
"e": 36.957,
"text": "в карман",
"seg": "s07"
},
{
"t": 36.957,
"e": 37.93,
"text": "не положишь.",
"seg": "s07"
},
{
"t": 38.15,
"e": 38.621,
"text": "Завтра:",
"seg": "s08"
},
{
"t": 38.621,
"e": 39.21,
"text": "Аладдин —",
"seg": "s08"
},
{
"t": 39.21,
"e": 40.269,
"text": "как старую лампу",
"seg": "s08"
},
{
"t": 40.269,
"e": 40.858,
"text": "выманили",
"seg": "s08"
},
{
"t": 40.858,
"e": 42.329,
"text": "«выгодным обменом».",
"seg": "s08"
},
{
"t": 42.329,
"e": 43.212,
"text": "Подпишись,",
"seg": "s08"
},
{
"t": 43.212,
"e": 43.801,
"text": "чтобы не",
"seg": "s08"
},
{
"t": 43.801,
"e": 44.919,
"text": "пропустить.",
"seg": "s08"
}
