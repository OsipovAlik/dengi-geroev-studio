{
"dur": 46.38883333333333,
"caps": [
{
"t": 0.2,
"e": 1.5,
"text": "Скинулись с друзьями",
"seg": "s01"
},
{
"t": 1.5,
"e": 2.799,
"text": "на общую вещь?",
"seg": "s01"
},
{
"t": 2.799,
"e": 3.567,
"text": "А если один",
"seg": "s01"
},
{
"t": 3.567,
"e": 4.867,
"text": "захочет выйти?",
"seg": "s01"
},
{
"t": 5.087,
"e": 6.292,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.292,
"e": 7.079,
"text": "три строчки,",
"seg": "s02"
},
{
"t": 7.079,
"e": 8.47,
"text": "которые спасут дружбу.",
"seg": "s02"
},
{
"t": 8.69,
"e": 9.599,
"text": "В теремке жили",
"seg": "s03"
},
{
"t": 9.599,
"e": 11.021,
"text": "звери без правил.",
"seg": "s03"
},
{
"t": 11.021,
"e": 11.988,
"text": "Пришёл медведь —",
"seg": "s03"
},
{
"t": 11.988,
"e": 13.523,
"text": "и терем развалился.",
"seg": "s03"
},
{
"t": 13.743,
"e": 14.604,
"text": "С общей покупкой",
"seg": "s04"
},
{
"t": 14.604,
"e": 15.321,
"text": "так же.",
"seg": "s04"
},
{
"t": 15.321,
"e": 16.229,
"text": "Четверо скинулись",
"seg": "s04"
},
{
"t": 16.229,
"e": 17.138,
"text": "по 25,",
"seg": "s04"
},
{
"t": 17.138,
"e": 18.811,
"text": "вещь стоит 100.",
"seg": "s04"
},
{
"t": 19.031,
"e": 19.666,
"text": "Через год",
"seg": "s05"
},
{
"t": 19.666,
"e": 20.416,
"text": "один уходит",
"seg": "s05"
},
{
"t": 20.416,
"e": 22.263,
"text": "и хочет свои 25.",
"seg": "s05"
},
{
"t": 22.263,
"e": 23.764,
"text": "А вещь стоит 60 —",
"seg": "s05"
},
{
"t": 23.764,
"e": 24.341,
"text": "его доля",
"seg": "s05"
},
{
"t": 24.341,
"e": 25.437,
"text": "15.",
"seg": "s05"
},
{
"t": 25.657,
"e": 26.395,
"text": "Тут дружба",
"seg": "s06"
},
{
"t": 26.395,
"e": 27.44,
"text": "и трещит.",
"seg": "s06"
},
{
"t": 27.44,
"e": 27.993,
"text": "Правило:",
"seg": "s06"
},
{
"t": 27.993,
"e": 28.731,
"text": "до покупки",
"seg": "s06"
},
{
"t": 28.731,
"e": 30.33,
"text": "запишите три вещи.",
"seg": "s06"
},
{
"t": 30.55,
"e": 32.185,
"text": "Кто сколько вложил.",
"seg": "s07"
},
{
"t": 32.185,
"e": 32.912,
"text": "Кто платит",
"seg": "s07"
},
{
"t": 32.912,
"e": 34.002,
"text": "за ремонт.",
"seg": "s07"
},
{
"t": 34.002,
"e": 35.092,
"text": "Как считать долю",
"seg": "s07"
},
{
"t": 35.092,
"e": 36.243,
"text": "при выходе.",
"seg": "s07"
},
{
"t": 36.463,
"e": 36.795,
"text": "Итог:",
"seg": "s08"
},
{
"t": 36.795,
"e": 37.793,
"text": "сначала договор —",
"seg": "s08"
},
{
"t": 37.793,
"e": 39.012,
"text": "потом теремок.",
"seg": "s08"
},
{
"t": 39.232,
"e": 39.734,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 39.734,
"e": 40.929,
"text": "собака и её тень —",
"seg": "s09"
},
{
"t": 40.929,
"e": 41.872,
"text": "почему «удвоим»",
"seg": "s09"
},
{
"t": 41.872,
"e": 43.003,
"text": "это обман.",
"seg": "s09"
},
{
"t": 43.003,
"e": 43.946,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 43.946,
"e": 44.575,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 44.575,
"e": 45.769,
"text": "пропустить.",
"seg": "s09"
}
],
