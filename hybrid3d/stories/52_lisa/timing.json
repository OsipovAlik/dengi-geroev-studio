{
"dur": 43.77375,
"caps": [
{
"t": 0.2,
"e": 1.325,
"text": "Берёте рассрочку",
"seg": "s01"
},
{
"t": 1.325,
"e": 2.45,
"text": "под 0%?",
"seg": "s01"
},
{
"t": 2.45,
"e": 3.637,
"text": "Можно переплатить",
"seg": "s01"
},
{
"t": 3.637,
"e": 5.261,
"text": "почти пятую часть.",
"seg": "s01"
},
{
"t": 5.481,
"e": 6.627,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.627,
"e": 7.288,
"text": "как проверить",
"seg": "s02"
},
{
"t": 7.288,
"e": 8.257,
"text": "это за минуту.",
"seg": "s02"
},
{
"t": 8.477,
"e": 9.5,
"text": "Лиса подала журавлю",
"seg": "s03"
},
{
"t": 9.5,
"e": 9.792,
"text": "кашу",
"seg": "s03"
},
{
"t": 9.792,
"e": 10.766,
"text": "на плоской тарелке:",
"seg": "s03"
},
{
"t": 10.766,
"e": 11.692,
"text": "угощение есть,",
"seg": "s03"
},
{
"t": 11.692,
"e": 12.666,
"text": "а не съесть.",
"seg": "s03"
},
{
"t": 12.886,
"e": 13.886,
"text": "Рассрочка под ноль —",
"seg": "s04"
},
{
"t": 13.886,
"e": 14.934,
"text": "та же тарелка.",
"seg": "s04"
},
{
"t": 15.154,
"e": 17.551,
"text": "Телефон стоит 100.",
"seg": "s05"
},
{
"t": 17.551,
"e": 18.876,
"text": "0% на год.",
"seg": "s05"
},
{
"t": 18.876,
"e": 19.759,
"text": "А в договоре:",
"seg": "s05"
},
{
"t": 19.759,
"e": 20.894,
"text": "страховка — 6",
"seg": "s05"
},
{
"t": 20.894,
"e": 21.84,
"text": "и оповещения —",
"seg": "s05"
},
{
"t": 21.84,
"e": 23.417,
"text": "по 1 в месяц.",
"seg": "s05"
},
{
"t": 23.637,
"e": 25.83,
"text": "100 + 6 + 12 —",
"seg": "s06"
},
{
"t": 25.83,
"e": 27.253,
"text": "118.",
"seg": "s06"
},
{
"t": 27.253,
"e": 27.905,
"text": "Переплата",
"seg": "s06"
},
{
"t": 27.905,
"e": 29.031,
"text": "18%.",
"seg": "s06"
},
{
"t": 29.251,
"e": 29.845,
"text": "Правило:",
"seg": "s07"
},
{
"t": 29.845,
"e": 30.638,
"text": "до подписи",
"seg": "s07"
},
{
"t": 30.638,
"e": 32.487,
"text": "сложите все платежи.",
"seg": "s07"
},
{
"t": 32.487,
"e": 33.411,
"text": "Больше цены —",
"seg": "s07"
},
{
"t": 33.411,
"e": 34.93,
"text": "значит, не ноль.",
"seg": "s07"
},
{
"t": 35.15,
"e": 35.44,
"text": "Итог:",
"seg": "s08"
},
{
"t": 35.44,
"e": 36.556,
"text": "считай не процент,",
"seg": "s08"
},
{
"t": 36.556,
"e": 37.622,
"text": "а общую сумму.",
"seg": "s08"
},
{
"t": 37.842,
"e": 38.309,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 38.309,
"e": 38.893,
"text": "Морозко —",
"seg": "s09"
},
{
"t": 38.893,
"e": 40.585,
"text": "как просить прибавку.",
"seg": "s09"
},
{
"t": 40.585,
"e": 41.461,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 41.461,
"e": 42.045,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 42.045,
"e": 43.154,
"text": "пропустить.",
"seg": "s09"
}
