{
"dur": 45.746875,
"caps": [
{
"t": 0.2,
"e": 1.377,
"text": "Зарплата пришла,",
"seg": "s01"
},
{
"t": 1.377,
"e": 2.442,
"text": "а через 3 дня",
"seg": "s01"
},
{
"t": 2.442,
"e": 3.507,
"text": "её уже нет?",
"seg": "s01"
},
{
"t": 3.507,
"e": 4.068,
"text": "Буратино",
"seg": "s01"
},
{
"t": 4.068,
"e": 5.245,
"text": "знает почему.",
"seg": "s01"
},
{
"t": 5.465,
"e": 6.639,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.639,
"e": 7.045,
"text": "правило",
"seg": "s02"
},
{
"t": 7.045,
"e": 8.354,
"text": "против таких покупок.",
"seg": "s02"
},
{
"t": 8.574,
"e": 9.222,
"text": "Папа Карло",
"seg": "s03"
},
{
"t": 9.222,
"e": 10.249,
"text": "продал куртку,",
"seg": "s03"
},
{
"t": 10.249,
"e": 11.005,
"text": "чтобы купить",
"seg": "s03"
},
{
"t": 11.005,
"e": 12.031,
"text": "ему азбуку.",
"seg": "s03"
},
{
"t": 12.031,
"e": 12.68,
"text": "А Буратино",
"seg": "s03"
},
{
"t": 12.68,
"e": 13.436,
"text": "увидел театр",
"seg": "s03"
},
{
"t": 13.436,
"e": 14.355,
"text": "и продал азбуку",
"seg": "s03"
},
{
"t": 14.355,
"e": 15.327,
"text": "за 4 сольдо —",
"seg": "s03"
},
{
"t": 15.327,
"e": 16.245,
"text": "на билет.",
"seg": "s03"
},
{
"t": 16.465,
"e": 17.285,
"text": "Захотелось —",
"seg": "s04"
},
{
"t": 17.285,
"e": 18.671,
"text": "и сразу купил.",
"seg": "s04"
},
{
"t": 18.671,
"e": 19.806,
"text": "Это импульсивная",
"seg": "s04"
},
{
"t": 19.806,
"e": 20.814,
"text": "покупка.",
"seg": "s04"
},
{
"t": 21.035,
"e": 21.757,
"text": "У нас так же:",
"seg": "s05"
},
{
"t": 21.757,
"e": 22.376,
"text": "скидка,",
"seg": "s05"
},
{
"t": 22.376,
"e": 22.789,
"text": "кнопка",
"seg": "s05"
},
{
"t": 22.789,
"e": 23.77,
"text": "«купить сейчас»,",
"seg": "s05"
},
{
"t": 23.77,
"e": 24.183,
"text": "и вещь",
"seg": "s05"
},
{
"t": 24.183,
"e": 25.318,
"text": "уже в корзине.",
"seg": "s05"
},
{
"t": 25.538,
"e": 26.363,
"text": "Две спонтанные",
"seg": "s06"
},
{
"t": 26.363,
"e": 26.827,
"text": "покупки",
"seg": "s06"
},
{
"t": 26.827,
"e": 28.115,
"text": "по 10 в неделю —",
"seg": "s06"
},
{
"t": 28.115,
"e": 29.301,
"text": "это 20.",
"seg": "s06"
},
{
"t": 29.301,
"e": 29.764,
"text": "За год —",
"seg": "s06"
},
{
"t": 29.764,
"e": 31.259,
"text": "1040.",
"seg": "s06"
},
{
"t": 31.479,
"e": 32.367,
"text": "Правило суток:",
"seg": "s07"
},
{
"t": 32.367,
"e": 33.314,
"text": "захотел купить",
"seg": "s07"
},
{
"t": 33.314,
"e": 34.202,
"text": "не по списку —",
"seg": "s07"
},
{
"t": 34.202,
"e": 36.096,
"text": "подожди 24 часа.",
"seg": "s07"
},
{
"t": 36.096,
"e": 36.983,
"text": "Часто желание",
"seg": "s07"
},
{
"t": 36.983,
"e": 38.285,
"text": "проходит само.",
"seg": "s07"
},
{
"t": 38.505,
"e": 39.543,
"text": "Сначала азбука,",
"seg": "s08"
},
{
"t": 39.543,
"e": 40.581,
"text": "потом театр.",
"seg": "s08"
},
{
"t": 40.801,
"e": 41.245,
"text": "Дальше:",
"seg": "s09"
},
{
"t": 41.245,
"e": 41.689,
"text": "свинья",
"seg": "s09"
},
{
"t": 41.689,
"e": 42.687,
"text": "под дубом.",
"seg": "s09"
},
{
"t": 42.687,
"e": 43.519,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 43.519,
"e": 44.073,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 44.073,
"e": 45.127,
"text": "пропустить.",
"seg": "s09"
}
