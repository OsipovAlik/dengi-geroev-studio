{
"dur": 43.99279166666667,
"caps": [
{
"t": 0.2,
"e": 1.075,
"text": "Заработать",
"seg": "s01"
},
{
"t": 1.075,
"e": 2.607,
"text": "за одну ночь?",
"seg": "s01"
},
{
"t": 2.607,
"e": 3.92,
"text": "Волк тоже хотел —",
"seg": "s01"
},
{
"t": 3.92,
"e": 5.89,
"text": "остался без хвоста.",
"seg": "s01"
},
{
"t": 6.11,
"e": 7.294,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 7.294,
"e": 7.84,
"text": "как узнать",
"seg": "s02"
},
{
"t": 7.84,
"e": 8.841,
"text": "такую ловушку.",
"seg": "s02"
},
{
"t": 9.061,
"e": 9.814,
"text": "Лиса сказала:",
"seg": "s03"
},
{
"t": 9.814,
"e": 10.942,
"text": "хвост в прорубь,",
"seg": "s03"
},
{
"t": 10.942,
"e": 11.641,
"text": "к утру рыба",
"seg": "s03"
},
{
"t": 11.641,
"e": 12.877,
"text": "сама наловится.",
"seg": "s03"
},
{
"t": 13.097,
"e": 14.462,
"text": "Хвост примёрз.",
"seg": "s04"
},
{
"t": 14.462,
"e": 15.268,
"text": "Ни рыбы,",
"seg": "s04"
},
{
"t": 15.268,
"e": 16.385,
"text": "ни хвоста.",
"seg": "s04"
},
{
"t": 16.605,
"e": 17.653,
"text": "Сегодня обещают",
"seg": "s05"
},
{
"t": 17.653,
"e": 18.947,
"text": "2% в день.",
"seg": "s05"
},
{
"t": 19.167,
"e": 19.79,
"text": "Посчитаем:",
"seg": "s06"
},
{
"t": 19.79,
"e": 20.299,
"text": "за год —",
"seg": "s06"
},
{
"t": 20.299,
"e": 20.978,
"text": "больше чем",
"seg": "s06"
},
{
"t": 20.978,
"e": 22.959,
"text": "в 1000 раз.",
"seg": "s06"
},
{
"t": 22.959,
"e": 23.808,
"text": "Так не платит",
"seg": "s06"
},
{
"t": 23.808,
"e": 24.601,
"text": "никто.",
"seg": "s06"
},
{
"t": 24.82,
"e": 25.243,
"text": "Правило:",
"seg": "s07"
},
{
"t": 25.243,
"e": 26.418,
"text": "не можешь объяснить,",
"seg": "s07"
},
{
"t": 26.418,
"e": 27.123,
"text": "откуда доход, —",
"seg": "s07"
},
{
"t": 27.123,
"e": 28.11,
"text": "не вкладывай.",
"seg": "s07"
},
{
"t": 28.33,
"e": 29.198,
"text": "Спроси три вещи:",
"seg": "s08"
},
{
"t": 29.198,
"e": 30.015,
"text": "кто платит,",
"seg": "s08"
},
{
"t": 30.015,
"e": 30.627,
"text": "за что,",
"seg": "s08"
},
{
"t": 30.627,
"e": 31.495,
"text": "и что будет,",
"seg": "s08"
},
{
"t": 31.495,
"e": 32.822,
"text": "если всё пропадёт.",
"seg": "s08"
},
{
"t": 33.042,
"e": 33.403,
"text": "Итог:",
"seg": "s09"
},
{
"t": 33.403,
"e": 34.424,
"text": "деньги за ночь —",
"seg": "s09"
},
{
"t": 34.424,
"e": 35.626,
"text": "это прорубь.",
"seg": "s09"
},
{
"t": 35.626,
"e": 37.368,
"text": "В ней остаётся хвост.",
"seg": "s09"
},
{
"t": 37.588,
"e": 38.108,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 38.108,
"e": 39.018,
"text": "курочка Ряба",
"seg": "s10"
},
{
"t": 39.018,
"e": 40.513,
"text": "и золотое яйцо.",
"seg": "s10"
},
{
"t": 40.513,
"e": 41.488,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 41.488,
"e": 42.138,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 42.138,
"e": 43.373,
"text": "пропустить.",
"seg": "s10"
}
],
