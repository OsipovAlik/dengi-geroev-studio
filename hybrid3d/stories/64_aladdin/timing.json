{
"dur": 46.06604166666666,
"caps": [
{
"t": 0.2,
"e": 1.487,
"text": "Чужой предлагает",
"seg": "s01"
},
{
"t": 1.487,
"e": 3.132,
"text": "выгодный обмен?",
"seg": "s01"
},
{
"t": 3.132,
"e": 4.062,
"text": "Так Аладдин",
"seg": "s01"
},
{
"t": 4.062,
"e": 5.636,
"text": "лишился всего.",
"seg": "s01"
},
{
"t": 5.856,
"e": 7.251,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 7.251,
"e": 7.895,
"text": "вопрос,",
"seg": "s02"
},
{
"t": 7.895,
"e": 9.184,
"text": "который спасает.",
"seg": "s02"
},
{
"t": 9.404,
"e": 10.468,
"text": "Колдун кричал:",
"seg": "s03"
},
{
"t": 10.468,
"e": 11.815,
"text": "«Меняю новые лампы",
"seg": "s03"
},
{
"t": 11.815,
"e": 12.596,
"text": "на старые!»",
"seg": "s03"
},
{
"t": 12.596,
"e": 13.376,
"text": "Во дворце",
"seg": "s03"
},
{
"t": 13.376,
"e": 14.227,
"text": "ему отдали",
"seg": "s03"
},
{
"t": 14.227,
"e": 14.866,
"text": "старую —",
"seg": "s03"
},
{
"t": 14.866,
"e": 16.142,
"text": "волшебную.",
"seg": "s03"
},
{
"t": 16.142,
"e": 16.852,
"text": "И дворец",
"seg": "s03"
},
{
"t": 16.852,
"e": 17.845,
"text": "исчез.",
"seg": "s03"
},
{
"t": 18.065,
"e": 19.222,
"text": "«Карта устарела —",
"seg": "s04"
},
{
"t": 19.222,
"e": 20.651,
"text": "назовите код».",
"seg": "s04"
},
{
"t": 20.651,
"e": 21.195,
"text": "«Сдайте",
"seg": "s04"
},
{
"t": 21.195,
"e": 22.352,
"text": "старый телефон —",
"seg": "s04"
},
{
"t": 22.352,
"e": 24.053,
"text": "новый со скидкой».",
"seg": "s04"
},
{
"t": 24.273,
"e": 25.086,
"text": "Отдали телефон",
"seg": "s05"
},
{
"t": 25.086,
"e": 26.051,
"text": "за 30,",
"seg": "s05"
},
{
"t": 26.051,
"e": 27.524,
"text": "доплатили 20.",
"seg": "s05"
},
{
"t": 27.524,
"e": 27.93,
"text": "Пришла",
"seg": "s05"
},
{
"t": 27.93,
"e": 28.794,
"text": "пустая коробка —",
"seg": "s05"
},
{
"t": 28.794,
"e": 30.064,
"text": "минус 50.",
"seg": "s05"
},
{
"t": 30.284,
"e": 30.918,
"text": "Правило:",
"seg": "s06"
},
{
"t": 30.918,
"e": 31.694,
"text": "чужой сам",
"seg": "s06"
},
{
"t": 31.694,
"e": 33.456,
"text": "предлагает обмен?",
"seg": "s06"
},
{
"t": 33.456,
"e": 34.232,
"text": "Зачем ему",
"seg": "s06"
},
{
"t": 34.232,
"e": 35.571,
"text": "моё старое?",
"seg": "s06"
},
{
"t": 35.571,
"e": 36.77,
"text": "Положите трубку",
"seg": "s06"
},
{
"t": 36.77,
"e": 38.532,
"text": "и проверьте сами.",
"seg": "s06"
},
{
"t": 38.752,
"e": 39.399,
"text": "Хороший обмен",
"seg": "s07"
},
{
"t": 39.399,
"e": 39.96,
"text": "не ищет вас",
"seg": "s07"
},
{
"t": 39.96,
"e": 40.477,
"text": "сам.",
"seg": "s07"
},
{
"t": 40.697,
"e": 41.231,
"text": "Дальше —",
"seg": "s08"
},
{
"t": 41.231,
"e": 41.647,
"text": "Кощей",
"seg": "s08"
},
{
"t": 41.647,
"e": 42.834,
"text": "и одно яйцо.",
"seg": "s08"
},
{
"t": 42.834,
"e": 43.725,
"text": "Подпишись,",
"seg": "s08"
},
{
"t": 43.725,
"e": 44.318,
"text": "чтобы не",
"seg": "s08"
},
{
"t": 44.318,
"e": 45.446,
"text": "пропустить.",
"seg": "s08"
}
],
