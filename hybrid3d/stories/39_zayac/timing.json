{
"dur": 44.18620833333333,
"caps": [
{
"t": 0.2,
"e": 1.794,
"text": "Стать поручителем",
"seg": "s01"
},
{
"t": 1.794,
"e": 3.389,
"text": "по кредиту?",
"seg": "s01"
},
{
"t": 3.389,
"e": 4.312,
"text": "Заяц тоже",
"seg": "s01"
},
{
"t": 4.312,
"e": 5.99,
"text": "пустил лису.",
"seg": "s01"
},
{
"t": 6.21,
"e": 7.358,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 7.358,
"e": 7.931,
"text": "правило,",
"seg": "s02"
},
{
"t": 7.931,
"e": 8.637,
"text": "которое спасёт",
"seg": "s02"
},
{
"t": 8.637,
"e": 9.52,
"text": "ваши деньги.",
"seg": "s02"
},
{
"t": 9.74,
"e": 10.44,
"text": "Лиса пожила",
"seg": "s03"
},
{
"t": 10.44,
"e": 10.979,
"text": "немного —",
"seg": "s03"
},
{
"t": 10.979,
"e": 11.895,
"text": "и выгнала зайца",
"seg": "s03"
},
{
"t": 11.895,
"e": 13.135,
"text": "из его избушки.",
"seg": "s03"
},
{
"t": 13.355,
"e": 14.414,
"text": "С поручительством",
"seg": "s04"
},
{
"t": 14.414,
"e": 15.25,
"text": "так же.",
"seg": "s04"
},
{
"t": 15.25,
"e": 16.197,
"text": "Друг не платит —",
"seg": "s04"
},
{
"t": 16.197,
"e": 17.256,
"text": "платите вы.",
"seg": "s04"
},
{
"t": 17.476,
"e": 19.239,
"text": "Друг взял 1000",
"seg": "s05"
},
{
"t": 19.239,
"e": 20.727,
"text": "и перестал платить.",
"seg": "s05"
},
{
"t": 20.727,
"e": 21.498,
"text": "Банк требует",
"seg": "s05"
},
{
"t": 21.498,
"e": 22.104,
"text": "с вас,",
"seg": "s05"
},
{
"t": 22.104,
"e": 23.206,
"text": "плюс штрафы.",
"seg": "s05"
},
{
"t": 23.426,
"e": 24.015,
"text": "Под ударом",
"seg": "s06"
},
{
"t": 24.015,
"e": 24.75,
"text": "ваша зарплата",
"seg": "s06"
},
{
"t": 24.75,
"e": 25.73,
"text": "и имущество.",
"seg": "s06"
},
{
"t": 25.95,
"e": 26.419,
"text": "Правило:",
"seg": "s07"
},
{
"t": 26.419,
"e": 27.672,
"text": "поручайся на сумму,",
"seg": "s07"
},
{
"t": 27.672,
"e": 28.454,
"text": "которую готов",
"seg": "s07"
},
{
"t": 28.454,
"e": 29.446,
"text": "отдать сам.",
"seg": "s07"
},
{
"t": 29.666,
"e": 30.653,
"text": "Не готов?",
"seg": "s08"
},
{
"t": 30.653,
"e": 31.583,
"text": "Откажи вежливо:",
"seg": "s08"
},
{
"t": 31.583,
"e": 32.919,
"text": "подписать не могу,",
"seg": "s08"
},
{
"t": 32.919,
"e": 34.255,
"text": "помогу советом.",
"seg": "s08"
},
{
"t": 34.475,
"e": 34.801,
"text": "Итог:",
"seg": "s09"
},
{
"t": 34.801,
"e": 35.943,
"text": "подпись поручителя —",
"seg": "s09"
},
{
"t": 35.943,
"e": 37.139,
"text": "это твой долг.",
"seg": "s09"
},
{
"t": 37.359,
"e": 37.851,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 37.851,
"e": 38.895,
"text": "Красная Шапочка",
"seg": "s10"
},
{
"t": 38.895,
"e": 39.571,
"text": "и бабушка",
"seg": "s10"
},
{
"t": 39.571,
"e": 40.862,
"text": "просит денег.",
"seg": "s10"
},
{
"t": 40.862,
"e": 41.784,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 41.784,
"e": 42.399,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 42.399,
"e": 43.566,
"text": "пропустить.",
"seg": "s10"
}
],
