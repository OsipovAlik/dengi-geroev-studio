{
"dur": 42.8435,
"caps": [
{
"t": 0.2,
"e": 1.22,
"text": "Выбрасываете чек",
"seg": "s01"
},
{
"t": 1.22,
"e": 1.617,
"text": "сразу",
"seg": "s01"
},
{
"t": 1.617,
"e": 2.863,
"text": "после покупки?",
"seg": "s01"
},
{
"t": 2.863,
"e": 3.26,
"text": "Петух",
"seg": "s01"
},
{
"t": 3.26,
"e": 4.28,
"text": "из басни Крылова",
"seg": "s01"
},
{
"t": 4.28,
"e": 5.13,
"text": "тоже выбросил",
"seg": "s01"
},
{
"t": 5.13,
"e": 6.15,
"text": "сокровище.",
"seg": "s01"
},
{
"t": 6.37,
"e": 7.531,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 7.531,
"e": 8.157,
"text": "привычка,",
"seg": "s02"
},
{
"t": 8.157,
"e": 8.871,
"text": "которая вернёт",
"seg": "s02"
},
{
"t": 8.871,
"e": 9.72,
"text": "вам деньги.",
"seg": "s02"
},
{
"t": 9.94,
"e": 10.733,
"text": "Петух нашёл",
"seg": "s03"
},
{
"t": 10.733,
"e": 11.343,
"text": "в навозе",
"seg": "s03"
},
{
"t": 11.343,
"e": 12.38,
"text": "жемчужное зерно:",
"seg": "s03"
},
{
"t": 12.38,
"e": 13.112,
"text": "какая вещь",
"seg": "s03"
},
{
"t": 13.112,
"e": 14.027,
"text": "пустая!",
"seg": "s03"
},
{
"t": 14.027,
"e": 14.637,
"text": "Лучше бы",
"seg": "s03"
},
{
"t": 14.637,
"e": 15.674,
"text": "ячменное.",
"seg": "s03"
},
{
"t": 15.894,
"e": 16.322,
"text": "И прошёл",
"seg": "s04"
},
{
"t": 16.322,
"e": 17.221,
"text": "мимо жемчуга.",
"seg": "s04"
},
{
"t": 17.441,
"e": 17.734,
"text": "Чек",
"seg": "s05"
},
{
"t": 17.734,
"e": 19.022,
"text": "и гарантийный талон —",
"seg": "s05"
},
{
"t": 19.022,
"e": 20.134,
"text": "наш жемчуг.",
"seg": "s05"
},
{
"t": 20.134,
"e": 21.48,
"text": "Пока всё работает,",
"seg": "s05"
},
{
"t": 21.48,
"e": 22.241,
"text": "они кажутся",
"seg": "s05"
},
{
"t": 22.241,
"e": 23.178,
"text": "мусором.",
"seg": "s05"
},
{
"t": 23.398,
"e": 24.377,
"text": "Телефон сломался",
"seg": "s06"
},
{
"t": 24.377,
"e": 26.009,
"text": "через 10 месяцев,",
"seg": "s06"
},
{
"t": 26.009,
"e": 27.205,
"text": "гарантия — год.",
"seg": "s06"
},
{
"t": 27.205,
"e": 27.695,
"text": "С чеком",
"seg": "s06"
},
{
"t": 27.695,
"e": 28.891,
"text": "ремонт бесплатно,",
"seg": "s06"
},
{
"t": 28.891,
"e": 29.489,
"text": "без чека —",
"seg": "s06"
},
{
"t": 29.489,
"e": 30.795,
"text": "150.",
"seg": "s06"
},
{
"t": 31.015,
"e": 31.44,
"text": "Правило:",
"seg": "s07"
},
{
"t": 31.44,
"e": 32.196,
"text": "в день покупки",
"seg": "s07"
},
{
"t": 32.196,
"e": 33.0,
"text": "сфотографируйте",
"seg": "s07"
},
{
"t": 33.0,
"e": 33.756,
"text": "чек и гарантию",
"seg": "s07"
},
{
"t": 33.756,
"e": 34.276,
"text": "и храните",
"seg": "s07"
},
{
"t": 34.276,
"e": 35.316,
"text": "в одной папке.",
"seg": "s07"
},
{
"t": 35.536,
"e": 36.109,
"text": "Не всё,",
"seg": "s08"
},
{
"t": 36.109,
"e": 36.682,
"text": "что похоже",
"seg": "s08"
},
{
"t": 36.682,
"e": 37.207,
"text": "на мусор, —",
"seg": "s08"
},
{
"t": 37.207,
"e": 37.876,
"text": "мусор.",
"seg": "s08"
},
{
"t": 38.096,
"e": 38.542,
"text": "Дальше:",
"seg": "s09"
},
{
"t": 38.542,
"e": 39.769,
"text": "скупой рыцарь.",
"seg": "s09"
},
{
"t": 39.769,
"e": 40.606,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 40.606,
"e": 41.164,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 41.164,
"e": 42.224,
"text": "пропустить.",
"seg": "s09"
}
