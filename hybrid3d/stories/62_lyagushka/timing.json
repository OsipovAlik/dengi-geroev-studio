{
"dur": 41.035875,
"caps": [
{
"t": 0.2,
"e": 1.351,
"text": "Берёте в кредит,",
"seg": "s01"
},
{
"t": 1.351,
"e": 2.009,
"text": "чтобы быть",
"seg": "s01"
},
{
"t": 2.009,
"e": 3.27,
"text": "не хуже других?",
"seg": "s01"
},
{
"t": 3.27,
"e": 3.983,
"text": "Так лопнула",
"seg": "s01"
},
{
"t": 3.983,
"e": 5.354,
"text": "лягушка из басни.",
"seg": "s01"
},
{
"t": 5.574,
"e": 6.791,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.791,
"e": 7.213,
"text": "сколько",
"seg": "s02"
},
{
"t": 7.213,
"e": 7.915,
"text": "на самом деле",
"seg": "s02"
},
{
"t": 7.915,
"e": 8.899,
"text": "стоит «статус».",
"seg": "s02"
},
{
"t": 9.119,
"e": 10.401,
"text": "Лягушка у Крылова",
"seg": "s03"
},
{
"t": 10.401,
"e": 11.346,
"text": "увидела вола",
"seg": "s03"
},
{
"t": 11.346,
"e": 12.696,
"text": "и стала дуться,",
"seg": "s03"
},
{
"t": 12.696,
"e": 14.384,
"text": "чтобы сравняться.",
"seg": "s03"
},
{
"t": 14.384,
"e": 15.396,
"text": "«Я уже как он?» —",
"seg": "s03"
},
{
"t": 15.396,
"e": 16.611,
"text": "и лопнула.",
"seg": "s03"
},
{
"t": 16.831,
"e": 17.403,
"text": "С деньгами",
"seg": "s04"
},
{
"t": 17.403,
"e": 17.785,
"text": "так же:",
"seg": "s04"
},
{
"t": 17.785,
"e": 18.214,
"text": "телефон",
"seg": "s04"
},
{
"t": 18.214,
"e": 19.024,
"text": "как у друга,",
"seg": "s04"
},
{
"t": 19.024,
"e": 19.406,
"text": "машина",
"seg": "s04"
},
{
"t": 19.406,
"e": 20.121,
"text": "как у соседа —",
"seg": "s04"
},
{
"t": 20.121,
"e": 20.932,
"text": "в кредит.",
"seg": "s04"
},
{
"t": 21.152,
"e": 22.64,
"text": "Телефон за 100",
"seg": "s05"
},
{
"t": 22.64,
"e": 23.172,
"text": "в кредит",
"seg": "s05"
},
{
"t": 23.172,
"e": 24.448,
"text": "под 30% на год —",
"seg": "s05"
},
{
"t": 24.448,
"e": 24.979,
"text": "отдадите",
"seg": "s05"
},
{
"t": 24.979,
"e": 26.574,
"text": "около 117.",
"seg": "s05"
},
{
"t": 26.574,
"e": 27.638,
"text": "Три таких покупки —",
"seg": "s05"
},
{
"t": 27.638,
"e": 29.02,
"text": "51 лишний.",
"seg": "s05"
},
{
"t": 29.24,
"e": 29.665,
"text": "Правило:",
"seg": "s06"
},
{
"t": 29.665,
"e": 30.186,
"text": "в кредит —",
"seg": "s06"
},
{
"t": 30.186,
"e": 31.084,
"text": "только нужное,",
"seg": "s06"
},
{
"t": 31.084,
"e": 31.699,
"text": "а не то,",
"seg": "s06"
},
{
"t": 31.699,
"e": 32.881,
"text": "что видно другим.",
"seg": "s06"
},
{
"t": 33.101,
"e": 33.735,
"text": "Не дуйтесь —",
"seg": "s07"
},
{
"t": 33.735,
"e": 34.468,
"text": "копите.",
"seg": "s07"
},
{
"t": 34.688,
"e": 35.146,
"text": "Завтра:",
"seg": "s08"
},
{
"t": 35.146,
"e": 36.12,
"text": "Волк и журавль —",
"seg": "s08"
},
{
"t": 36.12,
"e": 36.578,
"text": "работа",
"seg": "s08"
},
{
"t": 36.578,
"e": 37.895,
"text": "без предоплаты.",
"seg": "s08"
},
{
"t": 37.895,
"e": 38.755,
"text": "Подпишись,",
"seg": "s08"
},
{
"t": 38.755,
"e": 39.327,
"text": "чтобы не",
"seg": "s08"
},
{
"t": 39.327,
"e": 40.416,
"text": "пропустить.",
"seg": "s08"
}
