{
"dur": 41.97958333333333,
"caps": [
{
"t": 0.2,
"e": 1.586,
"text": "Берёте новый кредит,",
"seg": "s01"
},
{
"t": 1.586,
"e": 3.194,
"text": "чтобы закрыть старый?",
"seg": "s01"
},
{
"t": 3.194,
"e": 3.749,
"text": "Так долг",
"seg": "s01"
},
{
"t": 3.749,
"e": 4.691,
"text": "не уменьшается —",
"seg": "s01"
},
{
"t": 4.691,
"e": 5.689,
"text": "он растёт.",
"seg": "s01"
},
{
"t": 5.909,
"e": 7.069,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 7.069,
"e": 7.738,
"text": "как выбраться",
"seg": "s02"
},
{
"t": 7.738,
"e": 8.719,
"text": "из этой петли.",
"seg": "s02"
},
{
"t": 8.939,
"e": 9.86,
"text": "Тришка у Крылова",
"seg": "s03"
},
{
"t": 9.86,
"e": 10.525,
"text": "латал локти:",
"seg": "s03"
},
{
"t": 10.525,
"e": 11.548,
"text": "отрезал рукава,",
"seg": "s03"
},
{
"t": 11.548,
"e": 11.906,
"text": "потом",
"seg": "s03"
},
{
"t": 11.906,
"e": 12.98,
"text": "полы кафтана.",
"seg": "s03"
},
{
"t": 13.2,
"e": 14.095,
"text": "Дыры закрыты,",
"seg": "s04"
},
{
"t": 14.095,
"e": 14.841,
"text": "а кафтан стал",
"seg": "s04"
},
{
"t": 14.841,
"e": 15.984,
"text": "короче камзола.",
"seg": "s04"
},
{
"t": 16.204,
"e": 16.769,
"text": "С кредитами",
"seg": "s05"
},
{
"t": 16.769,
"e": 17.117,
"text": "так же:",
"seg": "s05"
},
{
"t": 17.117,
"e": 18.073,
"text": "долг 100",
"seg": "s05"
},
{
"t": 18.073,
"e": 18.812,
"text": "под 20% —",
"seg": "s05"
},
{
"t": 18.812,
"e": 20.29,
"text": "через год 120.",
"seg": "s05"
},
{
"t": 20.51,
"e": 21.085,
"text": "Закрыли",
"seg": "s06"
},
{
"t": 21.085,
"e": 22.171,
"text": "новым кредитом —",
"seg": "s06"
},
{
"t": 22.171,
"e": 24.343,
"text": "через год 144.",
"seg": "s06"
},
{
"t": 24.343,
"e": 24.982,
"text": "Ещё раз —",
"seg": "s06"
},
{
"t": 24.982,
"e": 26.515,
"text": "173.",
"seg": "s06"
},
{
"t": 26.735,
"e": 27.379,
"text": "Долг вырос",
"seg": "s07"
},
{
"t": 27.379,
"e": 28.399,
"text": "на 73%,",
"seg": "s07"
},
{
"t": 28.399,
"e": 29.258,
"text": "хотя вы ничего",
"seg": "s07"
},
{
"t": 29.258,
"e": 30.225,
"text": "не купили.",
"seg": "s07"
},
{
"t": 30.445,
"e": 30.974,
"text": "Правило:",
"seg": "s08"
},
{
"t": 30.974,
"e": 31.681,
"text": "не латайте",
"seg": "s08"
},
{
"t": 31.681,
"e": 32.858,
"text": "долг долгом.",
"seg": "s08"
},
{
"t": 32.858,
"e": 33.8,
"text": "Гасите сначала",
"seg": "s08"
},
{
"t": 33.8,
"e": 35.094,
"text": "самый дорогой.",
"seg": "s08"
},
{
"t": 35.314,
"e": 35.779,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 35.779,
"e": 36.942,
"text": "лисица и виноград —",
"seg": "s09"
},
{
"t": 36.942,
"e": 37.581,
"text": "почему мы",
"seg": "s09"
},
{
"t": 37.581,
"e": 38.802,
"text": "бросаем цели.",
"seg": "s09"
},
{
"t": 38.802,
"e": 39.674,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 39.674,
"e": 40.255,
