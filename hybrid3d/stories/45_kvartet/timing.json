{
"dur": 45.87016666666667,
"caps": [
{
"t": 0.2,
"e": 1.302,
"text": "Третье приложение",
"seg": "s01"
},
{
"t": 1.302,
"e": 2.289,
"text": "для бюджета,",
"seg": "s01"
},
{
"t": 2.289,
"e": 4.087,
"text": "а денег не прибавилось?",
"seg": "s01"
},
{
"t": 4.087,
"e": 5.074,
"text": "Квартет Крылова",
"seg": "s01"
},
{
"t": 5.074,
"e": 6.292,
"text": "делал так же.",
"seg": "s01"
},
{
"t": 6.512,
"e": 7.693,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 7.693,
"e": 8.829,
"text": "что чинит бюджет.",
"seg": "s02"
},
{
"t": 9.049,
"e": 10.236,
"text": "Мартышка, осёл,",
"seg": "s03"
},
{
"t": 10.236,
"e": 11.173,
"text": "козёл и мишка",
"seg": "s03"
},
{
"t": 11.173,
"e": 12.921,
"text": "играли — не выходило.",
"seg": "s03"
},
{
"t": 12.921,
"e": 13.546,
"text": "И начали",
"seg": "s03"
},
{
"t": 13.546,
"e": 14.982,
"text": "пересаживаться.",
"seg": "s03"
},
{
"t": 15.203,
"e": 16.079,
"text": "Пересели раз,",
"seg": "s04"
},
{
"t": 16.079,
"e": 16.81,
"text": "пересели два —",
"seg": "s04"
},
{
"t": 16.81,
"e": 17.297,
"text": "а музыка",
"seg": "s04"
},
{
"t": 17.297,
"e": 18.174,
"text": "всё та же.",
"seg": "s04"
},
{
"t": 18.394,
"e": 19.173,
"text": "Новый банк,",
"seg": "s05"
},
{
"t": 19.173,
"e": 20.001,
"text": "новая карта,",
"seg": "s05"
},
{
"t": 20.001,
"e": 20.926,
"text": "новое приложение —",
"seg": "s05"
},
{
"t": 20.926,
"e": 22.095,
"text": "та же пересадка.",
"seg": "s05"
},
{
"t": 22.315,
"e": 22.909,
"text": "Чинит план:",
"seg": "s06"
},
{
"t": 22.909,
"e": 23.453,
"text": "три числа",
"seg": "s06"
},
{
"t": 23.453,
"e": 24.442,
"text": "до зарплаты.",
"seg": "s06"
},
{
"t": 24.662,
"e": 25.331,
"text": "50% —",
"seg": "s07"
},
{
"t": 25.331,
"e": 26.413,
"text": "на обязательное,",
"seg": "s07"
},
{
"t": 26.413,
"e": 27.082,
"text": "30% —",
"seg": "s07"
},
{
"t": 27.082,
"e": 27.803,
"text": "на жизнь,",
"seg": "s07"
},
{
"t": 27.803,
"e": 28.473,
"text": "20% —",
"seg": "s07"
},
{
"t": 28.473,
"e": 29.658,
"text": "отложить сразу.",
"seg": "s07"
},
{
"t": 29.878,
"e": 31.128,
"text": "Из 100 тыс.:",
"seg": "s08"
},
{
"t": 31.128,
"e": 33.369,
"text": "50, 30 и 20.",
"seg": "s08"
},
{
"t": 33.369,
"e": 34.047,
"text": "За полгода —",
"seg": "s08"
},
{
"t": 34.047,
"e": 35.506,
"text": "120 тыс.",
"seg": "s08"
},
{
"t": 35.726,
"e": 36.015,
"text": "Итог:",
"seg": "s09"
},
{
"t": 36.015,
"e": 37.027,
"text": "как ни садитесь,",
"seg": "s09"
},
{
"t": 37.027,
"e": 37.557,
"text": "без плана",
"seg": "s09"
},
{
"t": 37.557,
"e": 38.714,
"text": "музыки не будет.",
"seg": "s09"
},
{
"t": 38.934,
"e": 39.415,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 39.415,
"e": 40.498,
"text": "мужик и медведь —",
"seg": "s10"
},
{
"t": 40.498,
"e": 41.4,
"text": "когда «пополам»",
"seg": "s10"
},
{
"t": 41.4,
"e": 42.603,
"text": "это ловушка.",
"seg": "s10"
},
{
"t": 42.603,
"e": 43.506,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 43.506,
"e": 44.107,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 44.107,
"e": 45.25,
"text": "пропустить.",
"seg": "s10"
}
],
