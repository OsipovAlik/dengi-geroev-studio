{
"dur": 44.93091666666667,
"caps": [
{
"t": 0.2,
"e": 1.248,
"text": "Деньги каждый месяц",
"seg": "s01"
},
{
"t": 1.248,
"e": 2.346,
"text": "уходят на мелочи,",
"seg": "s01"
},
{
"t": 2.346,
"e": 2.895,
"text": "о которых",
"seg": "s01"
},
{
"t": 2.895,
"e": 3.993,
"text": "потом жалеете?",
"seg": "s01"
},
{
"t": 4.213,
"e": 5.372,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 5.372,
"e": 5.952,
"text": "правило,",
"seg": "s02"
},
{
"t": 5.952,
"e": 6.532,
"text": "которое это",
"seg": "s02"
},
{
"t": 6.532,
"e": 7.335,
"text": "остановит.",
"seg": "s02"
},
{
"t": 7.555,
"e": 8.556,
"text": "Братец Иванушка",
"seg": "s03"
},
{
"t": 8.556,
"e": 9.263,
"text": "хотел пить",
"seg": "s03"
},
{
"t": 9.263,
"e": 10.499,
"text": "прямо сейчас.",
"seg": "s03"
},
{
"t": 10.499,
"e": 11.618,
"text": "Сестрица Алёнушка",
"seg": "s03"
},
{
"t": 11.618,
"e": 12.148,
"text": "просила:",
"seg": "s03"
},
{
"t": 12.148,
"e": 13.738,
"text": "потерпи до колодца.",
"seg": "s03"
},
{
"t": 13.958,
"e": 14.454,
"text": "Он попил",
"seg": "s04"
},
{
"t": 14.454,
"e": 15.099,
"text": "из копытца —",
"seg": "s04"
},
{
"t": 15.099,
"e": 15.495,
"text": "и стал",
"seg": "s04"
},
{
"t": 15.495,
"e": 16.487,
"text": "козлёночком.",
"seg": "s04"
},
{
"t": 16.707,
"e": 18.076,
"text": "Покупка на эмоциях —",
"seg": "s05"
},
{
"t": 18.076,
"e": 19.509,
"text": "то же копытце.",
"seg": "s05"
},
{
"t": 19.509,
"e": 20.421,
"text": "Пять мелочей",
"seg": "s05"
},
{
"t": 20.421,
"e": 21.724,
"text": "по 3% зарплаты —",
"seg": "s05"
},
{
"t": 21.724,
"e": 22.896,
"text": "минус 15%",
"seg": "s05"
},
{
"t": 22.896,
"e": 23.939,
"text": "в месяц.",
"seg": "s05"
},
{
"t": 24.159,
"e": 24.624,
"text": "За год —",
"seg": "s06"
},
{
"t": 24.624,
"e": 26.021,
"text": "почти две зарплаты.",
"seg": "s06"
},
{
"t": 26.241,
"e": 27.428,
"text": "Правило колодца:",
"seg": "s07"
},
{
"t": 27.428,
"e": 28.127,
"text": "захотел —",
"seg": "s07"
},
{
"t": 28.127,
"e": 29.663,
"text": "подожди сутки.",
"seg": "s07"
},
{
"t": 29.663,
"e": 31.688,
"text": "Дороже 10% зарплаты —",
"seg": "s07"
},
{
"t": 31.688,
"e": 32.735,
"text": "неделю.",
"seg": "s07"
},
{
"t": 32.735,
"e": 33.852,
"text": "Многие желания",
"seg": "s07"
},
{
"t": 33.852,
"e": 35.318,
"text": "пройдут сами.",
"seg": "s07"
},
{
"t": 35.538,
"e": 35.87,
"text": "Итог:",
"seg": "s08"
},
{
"t": 35.87,
"e": 36.864,
"text": "хочется сегодня —",
"seg": "s08"
},
{
"t": 36.864,
"e": 37.968,
"text": "купи завтра.",
"seg": "s08"
},
{
"t": 38.188,
"e": 38.637,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 38.637,
"e": 39.592,
"text": "лиса и журавль —",
"seg": "s09"
},
{
"t": 39.592,
"e": 40.379,
"text": "угощение,",
"seg": "s09"
},
{
"t": 40.379,
"e": 41.839,
"text": "которое не съесть.",
"seg": "s09"
},
{
"t": 41.839,
"e": 42.682,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 42.682,
"e": 43.244,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 43.244,
"e": 44.311,
"text": "пропустить.",
"seg": "s09"
}
