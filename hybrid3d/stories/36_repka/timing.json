{
"dur": 41.000791666666665,
"caps": [
{
"t": 0.2,
"e": 1.144,
"text": "Копишь один —",
"seg": "s01"
},
{
"t": 1.144,
"e": 2.831,
"text": "денег не хватает?",
"seg": "s01"
},
{
"t": 2.831,
"e": 3.64,
"text": "Репку тоже",
"seg": "s01"
},
{
"t": 3.64,
"e": 4.989,
"text": "не вытянуть.",
"seg": "s01"
},
{
"t": 5.209,
"e": 6.474,
"text": "Тридцать секунд —",
"seg": "s02"
},
{
"t": 6.474,
"e": 7.106,
"text": "правило",
"seg": "s02"
},
{
"t": 7.106,
"e": 8.933,
"text": "семейного бюджета.",
"seg": "s02"
},
{
"t": 9.153,
"e": 10.198,
"text": "Дед тянул репку",
"seg": "s03"
},
{
"t": 10.198,
"e": 11.611,
"text": "один — не вышло.",
"seg": "s03"
},
{
"t": 11.611,
"e": 12.41,
"text": "Позвал всех",
"seg": "s03"
},
{
"t": 12.41,
"e": 13.578,
"text": "по очереди.",
"seg": "s03"
},
{
"t": 13.798,
"e": 14.612,
"text": "Один откладывает",
"seg": "s04"
},
{
"t": 14.612,
"e": 15.38,
"text": "десять в месяц —",
"seg": "s04"
},
{
"t": 15.38,
"e": 16.012,
"text": "Сто двадцать",
"seg": "s04"
},
{
"t": 16.012,
"e": 16.645,
"text": "в год.",
"seg": "s04"
},
{
"t": 16.865,
"e": 17.549,
"text": "Вчетвером —",
"seg": "s05"
},
{
"t": 17.549,
"e": 18.804,
"text": "сорок в месяц.",
"seg": "s05"
},
{
"t": 18.804,
"e": 20.115,
"text": "Четыреста восемьдесят",
"seg": "s05"
},
{
"t": 20.115,
"e": 20.913,
"text": "в год.",
"seg": "s05"
},
{
"t": 21.133,
"e": 21.917,
"text": "Шаг первый:",
"seg": "s06"
},
{
"t": 21.917,
"e": 23.157,
"text": "общая цель.",
"seg": "s06"
},
{
"t": 23.157,
"e": 23.94,
"text": "Шаг второй:",
"seg": "s06"
},
{
"t": 23.94,
"e": 24.659,
"text": "у каждого",
"seg": "s06"
},
{
"t": 24.659,
"e": 25.834,
"text": "своя доля.",
"seg": "s06"
},
{
"t": 26.054,
"e": 26.787,
"text": "Даже мышка",
"seg": "s07"
},
{
"t": 26.787,
"e": 28.072,
"text": "тянула репку.",
"seg": "s07"
},
{
"t": 28.072,
"e": 28.867,
"text": "Малая сумма",
"seg": "s07"
},
{
"t": 28.867,
"e": 30.273,
"text": "тоже считается.",
"seg": "s07"
},
{
"t": 30.493,
"e": 30.937,
"text": "Говорите",
"seg": "s08"
},
{
"t": 30.937,
"e": 31.426,
"text": "о деньгах",
"seg": "s08"
},
{
"t": 31.426,
"e": 32.048,
"text": "вслух.",
"seg": "s08"
},
{
"t": 32.268,
"e": 32.817,
"text": "Вместе",
"seg": "s09"
},
{
"t": 32.817,
"e": 33.71,
"text": "быстрее,",
"seg": "s09"
},
{
"t": 33.71,
"e": 35.29,
"text": "чем в одиночку.",
"seg": "s09"
},
{
"t": 35.51,
"e": 35.974,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 35.974,
"e": 36.438,
"text": "Гусь с",
"seg": "s10"
},
{
"t": 36.438,
"e": 37.83,
"text": "золотыми яйцами.",
"seg": "s10"
},
{
"t": 37.83,
"e": 38.699,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 38.699,
"e": 39.279,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 39.279,
"e": 40.381,
"text": "пропустить.",
"seg": "s10"
}
