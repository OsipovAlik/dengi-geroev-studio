{
"dur": 44.299875,
"caps": [
{
"t": 0.2,
"e": 1.354,
"text": "Вас уже обманули,",
"seg": "s01"
},
{
"t": 1.354,
"e": 2.193,
"text": "и вдруг звонят:",
"seg": "s01"
},
{
"t": 2.193,
"e": 3.609,
"text": "«Вернём ваши деньги»?",
"seg": "s01"
},
{
"t": 3.829,
"e": 4.987,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 4.987,
"e": 5.521,
"text": "почему это",
"seg": "s02"
},
{
"t": 5.521,
"e": 6.367,
"text": "та же лиса.",
"seg": "s02"
},
{
"t": 6.587,
"e": 7.658,
"text": "Кот спас петушка",
"seg": "s03"
},
{
"t": 7.658,
"e": 8.609,
"text": "от лисы.",
"seg": "s03"
},
{
"t": 8.609,
"e": 9.62,
"text": "А назавтра лиса",
"seg": "s03"
},
{
"t": 9.62,
"e": 10.69,
"text": "снова под окном —",
"seg": "s03"
},
{
"t": 10.69,
"e": 12.058,
"text": "с новой песней.",
"seg": "s03"
},
{
"t": 12.278,
"e": 14.03,
"text": "Мошенники так же.",
"seg": "s04"
},
{
"t": 14.03,
"e": 15.432,
"text": "Сначала украли,",
"seg": "s04"
},
{
"t": 15.432,
"e": 16.413,
"text": "потом звонят:",
"seg": "s04"
},
{
"t": 16.413,
"e": 18.095,
"text": "«Поможем вернуть.",
"seg": "s04"
},
{
"t": 18.095,
"e": 20.338,
"text": "Нужен взнос — 10%».",
"seg": "s04"
},
{
"t": 20.558,
"e": 22.348,
"text": "Пропало 100 тыс. —",
"seg": "s05"
},
{
"t": 22.348,
"e": 24.139,
"text": "просят ещё 10.",
"seg": "s05"
},
{
"t": 24.139,
"e": 24.855,
"text": "Заплатили —",
"seg": "s05"
},
{
"t": 24.855,
"e": 26.645,
"text": "минус 110.",
"seg": "s05"
},
{
"t": 26.645,
"e": 28.316,
"text": "И лиса придёт снова.",
"seg": "s05"
},
{
"t": 28.536,
"e": 29.013,
"text": "Правило:",
"seg": "s06"
},
{
"t": 29.013,
"e": 29.969,
"text": "за возврат денег",
"seg": "s06"
},
{
"t": 29.969,
"e": 31.349,
"text": "заранее не платят.",
"seg": "s06"
},
{
"t": 31.349,
"e": 32.251,
"text": "Положите трубку",
"seg": "s06"
},
{
"t": 32.251,
"e": 33.577,
"text": "и сами позвоните в банк",
"seg": "s06"
},
{
"t": 33.577,
"e": 34.957,
"text": "по номеру с карты.",
"seg": "s06"
},
{
"t": 35.177,
"e": 35.505,
"text": "Итог:",
"seg": "s07"
},
{
"t": 35.505,
"e": 36.377,
"text": "второй звонок —",
"seg": "s07"
},
{
"t": 36.377,
"e": 37.414,
"text": "та же лиса.",
"seg": "s07"
},
{
"t": 37.634,
"e": 38.074,
"text": "Завтра:",
"seg": "s08"
},
{
"t": 38.074,
"e": 38.623,
"text": "Теремок —",
"seg": "s08"
},
{
"t": 38.623,
"e": 39.887,
"text": "как купить вскладчину",
"seg": "s08"
},
{
"t": 39.887,
"e": 41.261,
"text": "и не поссориться.",
"seg": "s08"
},
{
"t": 41.261,
"e": 42.086,
"text": "Подпишись,",
"seg": "s08"
},
{
"t": 42.086,
"e": 42.636,
"text": "чтобы не",
"seg": "s08"
},
{
"t": 42.636,
"e": 43.68,
"text": "пропустить.",
"seg": "s08"
}
