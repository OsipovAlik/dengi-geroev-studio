{
"dur": 42.59729166666666,
"caps": [
{
"t": 0.2,
"e": 1.784,
"text": "Вдвоём зарабатываете,",
"seg": "s01"
},
{
"t": 1.784,
"e": 2.332,
"text": "а денег",
"seg": "s01"
},
{
"t": 2.332,
"e": 3.551,
"text": "не остаётся?",
"seg": "s01"
},
{
"t": 3.551,
"e": 4.709,
"text": "Лебедь, рак и щука",
"seg": "s01"
},
{
"t": 4.709,
"e": 5.988,
"text": "знают почему.",
"seg": "s01"
},
{
"t": 6.208,
"e": 7.379,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 7.379,
"e": 7.964,
"text": "правило,",
"seg": "s02"
},
{
"t": 7.964,
"e": 9.27,
"text": "которое сдвигает воз.",
"seg": "s02"
},
{
"t": 9.49,
"e": 10.621,
"text": "Тянули один воз:",
"seg": "s03"
},
{
"t": 10.621,
"e": 12.085,
"text": "лебедь — в облака,",
"seg": "s03"
},
{
"t": 12.085,
"e": 13.149,
"text": "рак — назад,",
"seg": "s03"
},
{
"t": 13.149,
"e": 14.546,
"text": "щука — в воду.",
"seg": "s03"
},
{
"t": 14.766,
"e": 15.096,
"text": "А воз",
"seg": "s04"
},
{
"t": 15.096,
"e": 15.989,
"text": "и ныне там.",
"seg": "s04"
},
{
"t": 16.209,
"e": 17.087,
"text": "В семье так же:",
"seg": "s05"
},
{
"t": 17.087,
"e": 18.238,
"text": "один — на машину,",
"seg": "s05"
},
{
"t": 18.238,
"e": 19.499,
"text": "другой — на отпуск,",
"seg": "s05"
},
{
"t": 19.499,
"e": 20.925,
"text": "третий — на мелочи.",
"seg": "s05"
},
{
"t": 21.145,
"e": 21.795,
"text": "Каждый тянет",
"seg": "s06"
},
{
"t": 21.795,
"e": 22.584,
"text": "в свою сторону —",
"seg": "s06"
},
{
"t": 22.584,
"e": 23.327,
"text": "к концу месяца",
"seg": "s06"
},
{
"t": 23.327,
"e": 23.931,
"text": "ноль.",
"seg": "s06"
},
{
"t": 24.151,
"e": 24.671,
"text": "Правило:",
"seg": "s07"
},
{
"t": 24.671,
"e": 25.654,
"text": "одна общая цель",
"seg": "s07"
},
{
"t": 25.654,
"e": 26.579,
"text": "и общий взнос —",
"seg": "s07"
},
{
"t": 26.579,
"e": 28.081,
"text": "20% дохода.",
"seg": "s07"
},
{
"t": 28.302,
"e": 29.501,
"text": "С дохода 100 тыс. —",
"seg": "s08"
},
{
"t": 29.501,
"e": 30.584,
"text": "20 тыс. в месяц,",
"seg": "s08"
},
{
"t": 30.584,
"e": 31.668,
"text": "240 тыс.",
"seg": "s08"
},
{
"t": 31.668,
"e": 32.248,
"text": "за год.",
"seg": "s08"
},
{
"t": 32.468,
"e": 32.782,
"text": "Итог:",
"seg": "s09"
},
{
"t": 32.782,
"e": 33.516,
"text": "воз едет,",
"seg": "s09"
},
{
"t": 33.516,
"e": 34.406,
"text": "когда все тянут",
"seg": "s09"
},
{
"t": 34.406,
"e": 35.611,
"text": "в одну сторону.",
"seg": "s09"
},
{
"t": 35.831,
"e": 36.836,
"text": "Завтра: квартет —",
"seg": "s10"
},
{
"t": 36.836,
"e": 37.9,
"text": "новое приложение",
"seg": "s10"
},
{
"t": 37.9,
"e": 39.377,
"text": "не спасёт бюджет.",
"seg": "s10"
},
{
"t": 39.377,
"e": 40.263,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 40.263,
"e": 40.854,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 40.854,
"e": 41.977,
"text": "пропустить.",
"seg": "s10"
}
],
