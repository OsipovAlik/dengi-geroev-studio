{
"dur": 45.223083333333335,
"caps": [
{
"t": 0.2,
"e": 1.925,
"text": "Делим пополам?",
"seg": "s01"
},
{
"t": 1.925,
"e": 3.415,
"text": "Сначала спросите —",
"seg": "s01"
},
{
"t": 3.415,
"e": 5.376,
"text": "что именно делим.",
"seg": "s01"
},
{
"t": 5.596,
"e": 6.763,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.763,
"e": 7.526,
"text": "три вопроса,",
"seg": "s02"
},
{
"t": 7.526,
"e": 8.245,
"text": "которые спасут",
"seg": "s02"
},
{
"t": 8.245,
"e": 9.233,
"text": "вашу половину.",
"seg": "s02"
},
{
"t": 9.453,
"e": 10.482,
"text": "Мужик и медведь",
"seg": "s03"
},
{
"t": 10.482,
"e": 12.177,
"text": "пахали поле пополам.",
"seg": "s03"
},
{
"t": 12.177,
"e": 13.63,
"text": "Медведь выбрал вершки —",
"seg": "s03"
},
{
"t": 13.63,
"e": 14.175,
"text": "а мужик",
"seg": "s03"
},
{
"t": 14.175,
"e": 15.386,
"text": "посеял репу.",
"seg": "s03"
},
{
"t": 15.606,
"e": 16.547,
"text": "На другой год",
"seg": "s04"
},
{
"t": 16.547,
"e": 17.991,
"text": "медведь взял корешки —",
"seg": "s04"
},
{
"t": 17.991,
"e": 19.622,
"text": "а выросла пшеница.",
"seg": "s04"
},
{
"t": 19.622,
"e": 21.129,
"text": "Медведю — ничего.",
"seg": "s04"
},
{
"t": 21.349,
"e": 22.096,
"text": "Так и с деньгами:",
"seg": "s05"
},
{
"t": 22.096,
"e": 23.3,
"text": "выручка 100,",
"seg": "s05"
},
{
"t": 23.3,
"e": 24.421,
"text": "расходы 60.",
"seg": "s05"
},
{
"t": 24.641,
"e": 25.593,
"text": "Пополам прибыль —",
"seg": "s06"
},
{
"t": 25.593,
"e": 26.757,
"text": "по 20.",
"seg": "s06"
},
{
"t": 26.757,
"e": 27.868,
"text": "Пополам выручку,",
"seg": "s06"
},
{
"t": 27.868,
"e": 28.768,
"text": "а расходы ваши —",
"seg": "s06"
},
{
"t": 28.768,
"e": 30.408,
"text": "у вас минус 10.",
"seg": "s06"
},
{
"t": 30.628,
"e": 31.226,
"text": "Спросите:",
"seg": "s07"
},
{
"t": 31.226,
"e": 32.125,
"text": "что делим,",
"seg": "s07"
},
{
"t": 32.125,
"e": 33.562,
"text": "кто платит расходы,",
"seg": "s07"
},
{
"t": 33.562,
"e": 34.819,
"text": "кто выбирает.",
"seg": "s07"
},
{
"t": 34.819,
"e": 36.316,
"text": "И всё — на бумаге.",
"seg": "s07"
},
{
"t": 36.536,
"e": 36.848,
"text": "Итог:",
"seg": "s08"
},
{
"t": 36.848,
"e": 37.836,
"text": "важна не доля,",
"seg": "s08"
},
{
"t": 37.836,
"e": 38.98,
"text": "а от чего она.",
"seg": "s08"
},
{
"t": 39.2,
"e": 39.66,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 39.66,
"e": 40.695,
"text": "жадные медвежата",
"seg": "s09"
},
{
"t": 40.695,
"e": 42.074,
"text": "и лиса-посредник.",
"seg": "s09"
},
{
"t": 42.074,
"e": 42.936,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 42.936,
"e": 43.511,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 43.511,
"e": 44.603,
"text": "пропустить.",
"seg": "s09"
}
],
