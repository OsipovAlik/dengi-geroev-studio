{"dur": 45.96395833333333, "caps": [{"t": 0.2, "e": 0.957, "text": "Просят код", "seg": "s01"}, {"t": 0.957, "e": 1.84, "text": "из сообщения", "seg": "s01"}, {"t": 1.84, "e": 2.912, "text": "и срочно?", "seg": "s01"}, {"t": 2.912, "e": 3.479, "text": "Козлята", "seg": "s01"}, {"t": 3.479, "e": 4.678, "text": "не открыли.", "seg": "s01"}, {"t": 4.897, "e": 5.741, "text": "Тридцать секунд —", "seg": "s02"}, {"t": 5.741, "e": 6.397, "text": "три шага,", "seg": "s02"}, {"t": 6.397, "e": 7.193, "text": "которые спасают", "seg": "s02"}, {"t": 7.193, "e": 7.849, "text": "карту.", "seg": "s02"}, {"t": 8.069, "e": 9.054, "text": "Волк менял голос", "seg": "s03"}, {"t": 9.054, "e": 10.093, "text": "и красил лапу,", "seg": "s03"}, {"t": 10.093, "e": 11.186, "text": "чтобы войти.", "seg": "s03"}, {"t": 11.406, "e": 12.055, "text": "Сегодня так:", "seg": "s04"}, {"t": 12.055, "e": 12.454, "text": "звонят", "seg": "s04"}, {"t": 12.454, "e": 13.152, "text": "от банка,", "seg": "s04"}, {"t": 13.152, "e": 14.2, "text": "голос уверенный,", "seg": "s04"}, {"t": 14.2, "e": 15.147, "text": "просят код.", "seg": "s04"}, {"t": 15.367, "e": 16.657, "text": "Настоящий банк", "seg": "s05"}, {"t": 16.657, "e": 18.43, "text": "не просит код.", "seg": "s05"}, {"t": 18.43, "e": 18.914, "text": "Ноль", "seg": "s05"}, {"t": 18.914, "e": 20.446, "text": "исключений.", "seg": "s05"}, {"t": 20.666, "e": 22.016, "text": "Шаг первый:", "seg": "s06"}, {"t": 22.016, "e": 23.704, "text": "код не говорю", "seg": "s06"}, {"t": 23.704, "e": 25.393, "text": "никому.", "seg": "s06"}, {"t": 25.613, "e": 26.331, "text": "Шаг второй:", "seg": "s07"}, {"t": 26.331, "e": 27.588, "text": "кладу трубку.", "seg": "s07"}, {"t": 27.588, "e": 28.307, "text": "Шаг третий:", "seg": "s07"}, {"t": 28.307, "e": 29.384, "text": "перезваниваю сам", "seg": "s07"}, {"t": 29.384, "e": 30.043, "text": "по номеру", "seg": "s07"}, {"t": 30.043, "e": 31.001, "text": "с карты.", "seg": "s07"}, {"t": 31.221, "e": 32.685, "text": "Спешка —", "seg": "s08"}, {"t": 32.685, "e": 33.95, "text": "главный крючок.", "seg": "s08"}, {"t": 33.95, "e": 35.05, "text": "Хочешь спешить —", "seg": "s08"}, {"t": 35.05, "e": 36.426, "text": "пора проверять.", "seg": "s08"}, {"t": 36.646, "e": 37.398, "text": "Молчу.", "seg": "s09"}, {"t": 37.398, "e": 38.527, "text": "Кладу трубку.", "seg": "s09"}, {"t": 38.527, "e": 39.279, "text": "Перезваниваю", "seg": "s09"}, {"t": 39.279, "e": 39.923, "text": "сам.", "seg": "s09"}, {"t": 40.143, "e": 40.595, "text": "Завтра:", "seg": "s10"}, {"t": 40.595, "e": 41.104, "text": "Репка и", "seg": "s10"}, {"t": 41.104, "e": 42.009, "text": "общий семейный", "seg": "s10"}, {"t": 42.009, "e": 42.857, "text": "бюджет.", "seg": "s10"}, {"t": 42.857, "e": 43.705, "text": "Подпишись,", "seg": "s10"}, {"t": 43.705, "e": 44.27, "text": "чтобы не", "seg": "s10"}, {"t": 44.27, "e": 45.344, "text": "пропустить.", "seg": "s10"}], "segs": [{"id": "s01", "t": 0.2, "e": 4.678}, {"id": "s02", "t": 4.897, "e": 7.849}, {"id": "s03", "t": 8.069, "e": 11.186}, {"id": "s04", "t": 11.406, "e": 15.147}, {"id": "s05", "t": 15.367, "e": 20.446}, {"id": "s06", "t": 20.666, "e": 25.393}, {"id": "s07", "t": 25.613, "e": 31.001}, {"id": "s08", "t": 31.221, "e": 36.426}, {"id": "s09", "t": 36.646, "e": 39.923}, {"id": "s10", "t": 40.143, "e": 45.344}]}