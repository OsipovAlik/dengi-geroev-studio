{
"dur": 42.2855,
"caps": [
{
"t": 0.2,
"e": 0.735,
"text": "Думаете:",
"seg": "s01"
},
{
"t": 0.735,
"e": 1.389,
"text": "всё равно",
"seg": "s01"
},
{
"t": 1.389,
"e": 2.519,
"text": "не накоплю?",
"seg": "s01"
},
{
"t": 2.519,
"e": 3.47,
"text": "Так рассуждала",
"seg": "s01"
},
{
"t": 3.47,
"e": 4.957,
"text": "и лиса у Крылова.",
"seg": "s01"
},
{
"t": 5.177,
"e": 6.289,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.289,
"e": 6.973,
"text": "как дотянуться",
"seg": "s02"
},
{
"t": 6.973,
"e": 7.915,
"text": "до любой цели.",
"seg": "s02"
},
{
"t": 8.134,
"e": 8.825,
"text": "Лиса увидела",
"seg": "s03"
},
{
"t": 8.825,
"e": 9.86,
"text": "спелый виноград,",
"seg": "s03"
},
{
"t": 9.86,
"e": 10.797,
"text": "но не допрыгнула —",
"seg": "s03"
},
{
"t": 10.797,
"e": 11.34,
"text": "и сказала:",
"seg": "s03"
},
{
"t": 11.34,
"e": 12.178,
"text": "«он зелен».",
"seg": "s03"
},
{
"t": 12.398,
"e": 12.985,
"text": "Виноград",
"seg": "s04"
},
{
"t": 12.985,
"e": 14.16,
"text": "был хороший.",
"seg": "s04"
},
{
"t": 14.16,
"e": 14.982,
"text": "Просто висел",
"seg": "s04"
},
{
"t": 14.982,
"e": 16.332,
"text": "слишком высоко.",
"seg": "s04"
},
{
"t": 16.552,
"e": 17.147,
"text": "С деньгами",
"seg": "s05"
},
{
"t": 17.147,
"e": 17.543,
"text": "так же:",
"seg": "s05"
},
{
"t": 17.543,
"e": 18.683,
"text": "120 тысяч",
"seg": "s05"
},
{
"t": 18.683,
"e": 19.873,
"text": "кажутся недостижимыми —",
"seg": "s05"
},
{
"t": 19.873,
"e": 20.913,
"text": "и мы бросаем.",
"seg": "s05"
},
{
"t": 21.133,
"e": 21.508,
"text": "Делим",
"seg": "s06"
},
{
"t": 21.508,
"e": 22.738,
"text": "на 12 месяцев:",
"seg": "s06"
},
{
"t": 22.738,
"e": 24.236,
"text": "по 10 тысяч.",
"seg": "s06"
},
{
"t": 24.236,
"e": 25.68,
"text": "Это около 330",
"seg": "s06"
},
{
"t": 25.68,
"e": 26.482,
"text": "в день.",
"seg": "s06"
},
{
"t": 26.702,
"e": 27.404,
"text": "Каждый месяц —",
"seg": "s07"
},
{
"t": 27.404,
"e": 28.339,
"text": "одна ступенька,",
"seg": "s07"
},
{
"t": 28.339,
"e": 28.947,
"text": "и через год",
"seg": "s07"
},
{
"t": 28.947,
"e": 30.023,
"text": "гроздь в руках.",
"seg": "s07"
},
{
"t": 30.243,
"e": 30.779,
"text": "Правило:",
"seg": "s08"
},
{
"t": 30.779,
"e": 31.672,
"text": "большая цель —",
"seg": "s08"
},
{
"t": 31.672,
"e": 32.565,
"text": "это маленькие",
"seg": "s08"
},
{
"t": 32.565,
"e": 33.338,
"text": "шаги.",
"seg": "s08"
},
{
"t": 33.338,
"e": 34.35,
"text": "Сделайте первый",
"seg": "s08"
},
{
"t": 34.35,
"e": 35.303,
"text": "сегодня.",
"seg": "s08"
},
{
"t": 35.523,
"e": 35.969,
"text": "Завтра:",
"seg": "s09"
},
{
"t": 35.969,
"e": 36.863,
"text": "скупой рыцарь —",
"seg": "s09"
},
{
"t": 36.863,
"e": 37.868,
"text": "зачем копить,",
"seg": "s09"
},
{
"t": 37.868,
"e": 39.208,
"text": "если не тратить.",
"seg": "s09"
},
{
"t": 39.208,
"e": 40.046,
"text": "Подпишись,",
"seg": "s09"
},
{
"t": 40.046,
"e": 40.604,
"text": "чтобы не",
"seg": "s09"
},
{
"t": 40.604,
"e": 41.666,
"text": "пропустить.",
"seg": "s09"
}
],
