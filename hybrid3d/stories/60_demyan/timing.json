{
"dur": 44.89975,
"caps": [
{
"t": 0.2,
"e": 0.667,
"text": "Пришли",
"seg": "s01"
},
{
"t": 0.667,
"e": 1.836,
"text": "за одной вещью,",
"seg": "s01"
},
{
"t": 1.836,
"e": 2.596,
"text": "а чек вырос",
"seg": "s01"
},
{
"t": 2.596,
"e": 3.881,
"text": "на 40%?",
"seg": "s01"
},
{
"t": 3.881,
"e": 5.401,
"text": "Это Демьянова уха.",
"seg": "s01"
},
{
"t": 5.621,
"e": 6.892,
"text": "Через 30 секунд —",
"seg": "s02"
},
{
"t": 6.892,
"e": 7.723,
"text": "как сказать «нет»",
"seg": "s02"
},
{
"t": 7.723,
"e": 8.945,
"text": "и не переплатить.",
"seg": "s02"
},
{
"t": 9.165,
"e": 9.897,
"text": "У Крылова",
"seg": "s03"
},
{
"t": 9.897,
"e": 11.428,
"text": "Демьян потчует соседа:",
"seg": "s03"
},
{
"t": 11.428,
"e": 12.426,
"text": "«Ещё тарелочку!»",
"seg": "s03"
},
{
"t": 12.426,
"e": 13.69,
"text": "Тот давно сыт,",
"seg": "s03"
},
{
"t": 13.69,
"e": 14.222,
"text": "но ест",
"seg": "s03"
},
{
"t": 14.222,
"e": 15.686,
"text": "из вежливости.",
"seg": "s03"
},
{
"t": 15.906,
"e": 16.594,
"text": "В магазине:",
"seg": "s04"
},
{
"t": 16.594,
"e": 18.6,
"text": "Телефон за 100.",
"seg": "s04"
},
{
"t": 18.6,
"e": 19.575,
"text": "И «ещё тарелочку»:",
"seg": "s04"
},
{
"t": 19.575,
"e": 20.893,
"text": "чехол — 10,",
"seg": "s04"
},
{
"t": 20.893,
"e": 22.441,
"text": "страховка — 15,",
"seg": "s04"
},
{
"t": 22.441,
"e": 23.645,
"text": "доставка — 5,",
"seg": "s04"
},
{
"t": 23.645,
"e": 25.307,
"text": "подписка — 10.",
"seg": "s04"
},
{
"t": 25.527,
"e": 26.67,
"text": "Итого 140",
"seg": "s05"
},
{
"t": 26.67,
"e": 28.21,
"text": "вместо 100.",
"seg": "s05"
},
{
"t": 28.21,
"e": 29.403,
"text": "Плюс 40%.",
"seg": "s05"
},
{
"t": 29.623,
"e": 30.217,
"text": "Правило:",
"seg": "s06"
},
{
"t": 30.217,
"e": 30.943,
"text": "до оплаты",
"seg": "s06"
},
{
"t": 30.943,
"e": 31.603,
"text": "спросите",
"seg": "s06"
},
{
"t": 31.603,
"e": 33.122,
"text": "итоговую сумму.",
"seg": "s06"
},
{
"t": 33.122,
"e": 33.98,
"text": "Всё лишнее —",
"seg": "s06"
},
{
"t": 33.98,
"e": 34.64,
"text": "вежливое",
"seg": "s06"
},
{
"t": 34.64,
"e": 35.96,
"text": "«нет, спасибо».",
"seg": "s06"
},
{
"t": 36.18,
"e": 36.702,
"text": "Вежливость",
"seg": "s07"
},
{
"t": 36.702,
"e": 37.31,
"text": "не обязывает",
"seg": "s07"
},
{
"t": 37.31,
"e": 38.006,
"text": "платить.",
"seg": "s07"
},
{
"t": 38.226,
"e": 38.683,
"text": "Дальше:",
"seg": "s08"
},
{
"t": 38.683,
"e": 39.597,
"text": "Горшочек каши —",
"seg": "s08"
},
{
"t": 39.597,
"e": 40.625,
"text": "карта платит,",
"seg": "s08"
},
{
"t": 40.625,
"e": 41.767,
"text": "а денег нет.",
"seg": "s08"
},
{
"t": 41.767,
"e": 42.624,
"text": "Подпишись,",
"seg": "s08"
},
{
"t": 42.624,
"e": 43.195,
"text": "чтобы не",
"seg": "s08"
},
{
"t": 43.195,
"e": 44.28,
"text": "пропустить.",
"seg": "s08"
}
],
