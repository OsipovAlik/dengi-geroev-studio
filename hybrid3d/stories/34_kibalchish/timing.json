{
"dur": 44.36716666666667,
"caps": [
{
"t": 0.2,
"e": 0.919,
"text": "Копишь,",
"seg": "s01"
},
{
"t": 0.919,
"e": 1.518,
"text": "а деньги",
"seg": "s01"
},
{
"t": 1.518,
"e": 2.476,
"text": "утекают?",
"seg": "s01"
},
{
"t": 2.476,
"e": 3.135,
"text": "Кибальчиш",
"seg": "s01"
},
{
"t": 3.135,
"e": 4.332,
"text": "знал, почему.",
"seg": "s01"
},
{
"t": 4.552,
"e": 5.421,
"text": "Тридцать секунд —",
"seg": "s02"
},
{
"t": 5.421,
"e": 6.145,
"text": "и правило,",
"seg": "s02"
},
{
"t": 6.145,
"e": 7.399,
"text": "которое это чинит.",
"seg": "s02"
},
{
"t": 7.619,
"e": 8.19,
"text": "Кибальчиш",
"seg": "s03"
},
{
"t": 8.19,
"e": 8.761,
"text": "у Гайдара",
"seg": "s03"
},
{
"t": 8.761,
"e": 9.28,
"text": "держался",
"seg": "s03"
},
{
"t": 9.28,
"e": 10.422,
"text": "за общее дело.",
"seg": "s03"
},
{
"t": 10.642,
"e": 11.95,
"text": "«Сколько получится» —",
"seg": "s04"
},
{
"t": 11.95,
"e": 13.258,
"text": "не работает.",
"seg": "s04"
},
{
"t": 13.258,
"e": 14.304,
"text": "Нужны цель,",
"seg": "s04"
},
{
"t": 14.304,
"e": 14.762,
"text": "сумма",
"seg": "s04"
},
{
"t": 14.762,
"e": 15.743,
"text": "и срок.",
"seg": "s04"
},
{
"t": 15.963,
"e": 17.731,
"text": "Цель: 1200,",
"seg": "s05"
},
{
"t": 17.731,
"e": 18.074,
"text": "срок:",
"seg": "s05"
},
{
"t": 18.074,
"e": 19.614,
"text": "12 месяцев.",
"seg": "s05"
},
{
"t": 19.614,
"e": 21.611,
"text": "1200 ÷ 12 =",
"seg": "s05"
},
{
"t": 21.611,
"e": 23.437,
"text": "100 в месяц.",
"seg": "s05"
},
{
"t": 23.657,
"e": 25.078,
"text": "100 в месяц —",
"seg": "s06"
},
{
"t": 25.078,
"e": 26.007,
"text": "это ясно.",
"seg": "s06"
},
{
"t": 26.007,
"e": 26.99,
"text": "А «что останется» —",
"seg": "s06"
},
{
"t": 26.99,
"e": 27.919,
"text": "это ноль.",
"seg": "s06"
},
{
"t": 28.139,
"e": 28.864,
"text": "Правило второе:",
"seg": "s07"
},
{
"t": 28.864,
"e": 29.409,
"text": "откладывай",
"seg": "s07"
},
{
"t": 29.409,
"e": 30.27,
"text": "в день дохода,",
"seg": "s07"
},
{
"t": 30.27,
"e": 30.905,
"text": "а не в конце",
"seg": "s07"
},
{
"t": 30.905,
"e": 31.586,
"text": "месяца.",
"seg": "s07"
},
{
"t": 31.806,
"e": 32.207,
"text": "Сначала",
"seg": "s08"
},
{
"t": 32.207,
"e": 33.143,
"text": "заплати за цель,",
"seg": "s08"
},
{
"t": 33.143,
"e": 33.678,
"text": "потом живи",
"seg": "s08"
},
{
"t": 33.678,
"e": 34.615,
"text": "на остальное.",
"seg": "s08"
},
{
"t": 34.835,
"e": 35.168,
"text": "Цель",
"seg": "s09"
},
{
"t": 35.168,
"e": 35.722,
"text": "с числом",
"seg": "s09"
},
{
"t": 35.722,
"e": 36.221,
"text": "и датой",
"seg": "s09"
},
{
"t": 36.221,
"e": 37.385,
"text": "копится сама.",
"seg": "s09"
},
{
"t": 37.605,
"e": 38.04,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 38.04,
"e": 38.475,
"text": "Волк и",
"seg": "s10"
},
{
"t": 38.475,
"e": 39.344,
"text": "семеро козлят —",
"seg": "s10"
},
{
"t": 39.344,
"e": 40.051,
"text": "кому нельзя",
"seg": "s10"
},
{
"t": 40.051,
"e": 41.355,
"text": "открывать дверь.",
"seg": "s10"
},
{
"t": 41.355,
"e": 42.171,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 42.171,
"e": 42.714,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 42.714,
"e": 43.747,
"text": "пропустить.",
"seg": "s10"
}
],
