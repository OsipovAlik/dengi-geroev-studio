{
"dur": 40.515791666666665,
"caps": [
{
"t": 0.2,
"e": 0.915,
"text": "Копишь,",
"seg": "s01"
},
{
"t": 0.915,
"e": 2.227,
"text": "а деньги тают?",
"seg": "s01"
},
{
"t": 2.227,
"e": 2.883,
"text": "Кибальчиш",
"seg": "s01"
},
{
"t": 2.883,
"e": 4.373,
"text": "крепость не сдал.",
"seg": "s01"
},
{
"t": 4.593,
"e": 5.424,
"text": "Тридцать секунд —",
"seg": "s02"
},
{
"t": 5.424,
"e": 6.024,
"text": "правило,",
"seg": "s02"
},
{
"t": 6.024,
"e": 6.854,
"text": "которое защищает",
"seg": "s02"
},
{
"t": 6.854,
"e": 7.731,
"text": "накопления.",
"seg": "s02"
},
{
"t": 7.951,
"e": 8.44,
"text": "Кибальчиш",
"seg": "s03"
},
{
"t": 8.44,
"e": 8.929,
"text": "у Гайдара",
"seg": "s03"
},
{
"t": 8.929,
"e": 9.373,
"text": "не выдал",
"seg": "s03"
},
{
"t": 9.373,
"e": 10.35,
"text": "военную тайну.",
"seg": "s03"
},
{
"t": 10.57,
"e": 11.429,
"text": "Твоя тайна —",
"seg": "s04"
},
{
"t": 11.429,
"e": 12.684,
"text": "накопления.",
"seg": "s04"
},
{
"t": 12.684,
"e": 14.005,
"text": "Давят не враги,",
"seg": "s04"
},
{
"t": 14.005,
"e": 15.194,
"text": "а желания.",
"seg": "s04"
},
{
"t": 15.414,
"e": 16.606,
"text": "10 в месяц —",
"seg": "s05"
},
{
"t": 16.606,
"e": 18.366,
"text": "за год 120.",
"seg": "s05"
},
{
"t": 18.366,
"e": 19.218,
"text": "Три раза взял",
"seg": "s05"
},
{
"t": 19.218,
"e": 20.126,
"text": "по 20 —",
"seg": "s05"
},
{
"t": 20.126,
"e": 21.715,
"text": "осталось 60.",
"seg": "s05"
},
{
"t": 21.935,
"e": 22.729,
"text": "Правило первое:",
"seg": "s06"
},
{
"t": 22.729,
"e": 23.175,
"text": "фонд на",
"seg": "s06"
},
{
"t": 23.175,
"e": 24.366,
"text": "отдельном счёте.",
"seg": "s06"
},
{
"t": 24.585,
"e": 24.987,
"text": "Второе:",
"seg": "s07"
},
{
"t": 24.987,
"e": 25.789,
"text": "хочется взять —",
"seg": "s07"
},
{
"t": 25.789,
"e": 26.24,
"text": "подожди",
"seg": "s07"
},
{
"t": 26.24,
"e": 27.443,
"text": "30 дней.",
"seg": "s07"
},
{
"t": 27.663,
"e": 28.313,
"text": "Фонд трогают",
"seg": "s08"
},
{
"t": 28.313,
"e": 29.148,
"text": "только ради цели",
"seg": "s08"
},
{
"t": 29.148,
"e": 29.936,
"text": "или беды.",
"seg": "s08"
},
{
"t": 30.156,
"e": 31.007,
"text": "Крепость держит",
"seg": "s09"
},
{
"t": 31.007,
"e": 31.909,
"text": "тот, кто не сдаёт",
"seg": "s09"
},
{
"t": 31.909,
"e": 32.96,
"text": "её по мелочи.",
"seg": "s09"
},
{
"t": 33.18,
"e": 33.61,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 33.61,
"e": 34.04,
"text": "Волк и",
"seg": "s10"
},
{
"t": 34.04,
"e": 34.899,
"text": "семеро козлят —",
"seg": "s10"
},
{
"t": 34.899,
"e": 35.598,
"text": "кому нельзя",
"seg": "s10"
},
{
"t": 35.598,
"e": 36.565,
"text": "открывать доступ",
"seg": "s10"
},
{
"t": 36.565,
"e": 37.532,
"text": "к деньгам.",
"seg": "s10"
},
{
"t": 37.532,
"e": 38.338,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 38.338,
"e": 38.875,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 38.875,
"e": 39.896,
"text": "пропустить.",
"seg": "s10"
}
