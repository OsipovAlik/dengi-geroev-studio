{
"dur": 41.38104166666667,
"caps": [
{
"t": 0.2,
"e": 1.294,
"text": "Звонят «из банка»",
"seg": "s01"
},
{
"t": 1.294,
"e": 2.645,
"text": "и просят код?",
"seg": "s01"
},
{
"t": 2.645,
"e": 3.546,
"text": "Козлята тоже",
"seg": "s01"
},
{
"t": 3.546,
"e": 4.511,
"text": "открыли дверь",
"seg": "s01"
},
{
"t": 4.511,
"e": 5.476,
"text": "чужому.",
"seg": "s01"
},
{
"t": 5.696,
"e": 6.51,
"text": "Тридцать секунд —",
"seg": "s02"
},
{
"t": 6.51,
"e": 7.099,
"text": "правило,",
"seg": "s02"
},
{
"t": 7.099,
"e": 7.868,
"text": "которое бережёт",
"seg": "s02"
},
{
"t": 7.868,
"e": 8.502,
"text": "карту.",
"seg": "s02"
},
{
"t": 8.722,
"e": 9.0,
"text": "Волк",
"seg": "s03"
},
{
"t": 9.0,
"e": 9.79,
"text": "у братьев Гримм",
"seg": "s03"
},
{
"t": 9.79,
"e": 10.44,
"text": "съел мел,",
"seg": "s03"
},
{
"t": 10.44,
"e": 11.23,
"text": "чтобы подделать",
"seg": "s03"
},
{
"t": 11.23,
"e": 12.159,
"text": "мамин голос.",
"seg": "s03"
},
{
"t": 12.379,
"e": 13.262,
"text": "Сегодня так же:",
"seg": "s04"
},
{
"t": 13.262,
"e": 14.366,
"text": "голос в трубке,",
"seg": "s04"
},
{
"t": 14.366,
"e": 15.249,
"text": "письмо, ссылка —",
"seg": "s04"
},
{
"t": 15.249,
"e": 15.912,
"text": "всё похоже",
"seg": "s04"
},
{
"t": 15.912,
"e": 17.071,
"text": "на настоящее.",
"seg": "s04"
},
{
"t": 17.291,
"e": 18.472,
"text": "Но настоящий банк",
"seg": "s05"
},
{
"t": 18.472,
"e": 19.404,
"text": "не просит код",
"seg": "s05"
},
{
"t": 19.404,
"e": 20.709,
"text": "из сообщения.",
"seg": "s05"
},
{
"t": 20.709,
"e": 21.703,
"text": "Никогда.",
"seg": "s05"
},
{
"t": 21.923,
"e": 22.315,
"text": "Первое:",
"seg": "s06"
},
{
"t": 22.315,
"e": 23.05,
"text": "сомневаешься —",
"seg": "s06"
},
{
"t": 23.05,
"e": 23.784,
"text": "положи трубку",
"seg": "s06"
},
{
"t": 23.784,
"e": 24.519,
"text": "и позвони сам",
"seg": "s06"
},
{
"t": 24.519,
"e": 25.793,
"text": "по номеру с карты.",
"seg": "s06"
},
{
"t": 26.013,
"e": 26.436,
"text": "Второе:",
"seg": "s07"
},
{
"t": 26.436,
"e": 27.071,
"text": "код, пароль",
"seg": "s07"
},
{
"t": 27.071,
"e": 28.076,
"text": "и цифры с оборота",
"seg": "s07"
},
{
"t": 28.076,
"e": 29.399,
"text": "не говори никому.",
"seg": "s07"
},
{
"t": 29.619,
"e": 30.075,
"text": "Третье:",
"seg": "s08"
},
{
"t": 30.075,
"e": 30.646,
"text": "торопят —",
"seg": "s08"
},
{
"t": 30.646,
"e": 31.845,
"text": "значит, обман.",
"seg": "s08"
},
{
"t": 32.065,
"e": 32.805,
"text": "Дверь открывай",
"seg": "s09"
},
{
"t": 32.805,
"e": 33.592,
"text": "только тому,",
"seg": "s09"
},
{
"t": 33.592,
"e": 34.656,
"text": "кого узнал сам.",
"seg": "s09"
},
{
"t": 34.876,
"e": 35.342,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 35.342,
"e": 35.809,
"text": "Репка —",
"seg": "s10"
},
{
"t": 35.809,
"e": 36.624,
"text": "как накопить",
"seg": "s10"
},
{
"t": 36.624,
"e": 38.197,
"text": "вместе всей семьёй.",
"seg": "s10"
},
{
"t": 38.197,
"e": 39.071,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 39.071,
"e": 39.654,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 39.654,
"e": 40.761,
"text": "пропустить.",
"seg": "s10"
}
],
