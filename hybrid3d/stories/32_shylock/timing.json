{
"dur": 40.046,
"caps": [
{
"t": 0.2,
"e": 0.981,
"text": "Подписываете",
"seg": "s01"
},
{
"t": 0.981,
"e": 1.707,
"text": "договор,",
"seg": "s01"
},
{
"t": 1.707,
"e": 2.655,
"text": "не читая?",
"seg": "s01"
},
{
"t": 2.655,
"e": 3.437,
"text": "Шейлок читал",
"seg": "s01"
},
{
"t": 3.437,
"e": 4.72,
"text": "каждую строчку.",
"seg": "s01"
},
{
"t": 4.94,
"e": 6.094,
"text": "Тридцать секунд —",
"seg": "s02"
},
{
"t": 6.094,
"e": 6.864,
"text": "три строки",
"seg": "s02"
},
{
"t": 6.864,
"e": 8.082,
"text": "до подписи.",
"seg": "s02"
},
{
"t": 8.302,
"e": 9.05,
"text": "Купец Антонио",
"seg": "s03"
},
{
"t": 9.05,
"e": 9.698,
"text": "взял в долг",
"seg": "s03"
},
{
"t": 9.698,
"e": 10.296,
"text": "и не глядя",
"seg": "s03"
},
{
"t": 10.296,
"e": 11.443,
"text": "подписал штраф.",
"seg": "s03"
},
{
"t": 11.663,
"e": 12.572,
"text": "Строка первая:",
"seg": "s04"
},
{
"t": 12.572,
"e": 13.481,
"text": "что будет,",
"seg": "s04"
},
{
"t": 13.481,
"e": 14.753,
"text": "если опоздаю?",
"seg": "s04"
},
{
"t": 14.753,
"e": 15.177,
"text": "Штраф",
"seg": "s04"
},
{
"t": 15.177,
"e": 16.753,
"text": "10% в день.",
"seg": "s04"
},
{
"t": 16.973,
"e": 17.389,
"text": "Опоздал",
"seg": "s05"
},
{
"t": 17.389,
"e": 18.362,
"text": "на 10 дней —",
"seg": "s05"
},
{
"t": 18.362,
"e": 19.659,
"text": "это 100%.",
"seg": "s05"
},
{
"t": 19.659,
"e": 20.863,
"text": "Взял 100,",
"seg": "s05"
},
{
"t": 20.863,
"e": 22.298,
"text": "вернул 200.",
"seg": "s05"
},
{
"t": 22.518,
"e": 23.17,
"text": "Строка вторая:",
"seg": "s06"
},
{
"t": 23.17,
"e": 23.951,
"text": "кто отвечает,",
"seg": "s06"
},
{
"t": 23.951,
"e": 25.08,
"text": "если не заплатишь?",
"seg": "s06"
},
{
"t": 25.08,
"e": 25.558,
"text": "Только ты",
"seg": "s06"
},
{
"t": 25.558,
"e": 26.556,
"text": "или поручитель?",
"seg": "s06"
},
{
"t": 26.776,
"e": 27.448,
"text": "Строка третья:",
"seg": "s07"
},
{
"t": 27.448,
"e": 27.896,
"text": "можно ли",
"seg": "s07"
},
{
"t": 27.896,
"e": 28.3,
"text": "вернуть",
"seg": "s07"
},
{
"t": 28.3,
"e": 29.241,
"text": "раньше срока?",
"seg": "s07"
},
{
"t": 29.461,
"e": 30.188,
"text": "Не понятно —",
"seg": "s08"
},
{
"t": 30.188,
"e": 31.42,
"text": "не подписывай.",
"seg": "s08"
},
{
"t": 31.42,
"e": 32.652,
"text": "Сначала прочитал,",
"seg": "s08"
},
{
"t": 32.652,
"e": 33.94,
"text": "потом подписал.",
"seg": "s08"
},
{
"t": 34.16,
"e": 34.589,
"text": "Завтра:",
"seg": "s10"
},
{
"t": 34.589,
"e": 35.396,
"text": "Мальчиш-Плохиш",
"seg": "s10"
},
{
"t": 35.396,
"e": 35.987,
"text": "и сладкое",
"seg": "s10"
},
{
"t": 35.987,
"e": 37.061,
"text": "предложение.",
"seg": "s10"
},
{
"t": 37.061,
"e": 37.868,
"text": "Подпишись,",
"seg": "s10"
},
{
"t": 37.868,
"e": 38.405,
"text": "чтобы не",
"seg": "s10"
},
{
"t": 38.405,
"e": 39.426,
"text": "пропустить.",
"seg": "s10"
}
